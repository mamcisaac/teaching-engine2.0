generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subject {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int?
  createdAt DateTime @default(now())
  nameEn    String?
  nameFr    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model ClassroomAnnouncement {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  timeframe String
  contentFr String
  contentEn String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique
  password                 String
  name                     String
  role                     String                    @default("teacher")
  grade                    String?
  program                  String?
  preferredLanguage        String                    @default("en")
  activityCollections      ActivityCollection[]
  activityImports          ActivityImport[]
  activityRatings          ActivityRating[]
  uploadedArtifacts        Artifact[]
  assessments              Assessment[]
  events                   CalendarEvent[]
  classRoutines            ClassRoutine[]
  classroomAnnouncements   ClassroomAnnouncement[]
  curriculumImports        CurriculumImport[]
  daybookEntries           DaybookEntry[]
  etfoLessonPlans          ETFOLessonPlan[]
  longRangePlans           LongRangePlan[]
  newsletters              Newsletter[]
  notifications            Notification[]
  performanceTaskTemplates PerformanceTaskTemplate[]
  createdTemplates         PlanTemplate[]
  recentPlanAccess         RecentPlanAccess[]
  reports                  Report[]
  students                 Student[]
  studentArtifacts         StudentArtifact[]
  studentOutcomeProgress   StudentOutcomeProgress[]
  subjects                 Subject[]
  substitutePlans          SubstitutePlan[]
  unavailableBlocks        UnavailableBlock[]
  unitPlans                UnitPlan[]
  weeklyPlannerState       WeeklyPlannerState?
  lessonCompletions        LessonCompletion[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

model CalendarEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  eventType   String
  source      String   @default("MANUAL")
  teacherId   Int?
  schoolId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     User?    @relation(fields: [teacherId], references: [id])
}

model UnavailableBlock {
  id        Int      @id @default(autoincrement())
  teacherId Int?
  date      DateTime
  startMin  Int
  endMin    Int
  reason    String
  blockType String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   User?    @relation(fields: [teacherId], references: [id])
}

model CurriculumImport {
  id                     String                  @id @default(cuid())
  userId                 Int
  filename               String?
  originalName           String?
  mimeType               String?
  fileSize               Int?
  filePath               String?
  grade                  Int?
  subject                String?
  status                 String                  @default("UPLOADING")
  sourceFormat           String?
  sourceFile             String?
  rawText                String?
  parsedData             String?
  errorMessage           String?
  totalOutcomes          Int                     @default(0)
  processedOutcomes      Int                     @default(0)
  errorLog               Json?
  metadata               Json?
  processedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  completedAt            DateTime?
  curriculumExpectations CurriculumExpectation[] @relation("CurriculumExpectationImport")
  user                   User                    @relation(fields: [userId], references: [id])
  clusters               ExpectationCluster[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, status, createdAt])
}

model ExpectationCluster {
  id             String           @id @default(cuid())
  importId       String
  clusterName    String
  clusterType    String
  expectationIds Json
  centroid       Json?
  confidence     Float            @default(0.0)
  suggestedTheme String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  import         CurriculumImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([clusterType])
}

model ClassRoutine {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String
  category    String
  timeOfDay   String?
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, category])
  @@index([userId, isActive])
}

model CurriculumExpectation {
  id               String                          @id @default(cuid())
  code             String                          @unique
  description      String
  strand           String
  substrand        String?
  grade            Int
  subject          String
  descriptionFr    String?
  strandFr         String?
  substrandFr      String?
  importId         String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  title            String?
  titleFr          String?
  import           CurriculumImport?               @relation("CurriculumExpectationImport", fields: [importId], references: [id])
  embedding        CurriculumExpectationEmbedding?
  daybookEntries   DaybookEntryExpectation[]
  lessonPlans      ETFOLessonPlanExpectation[]
  longRangePlans   LongRangePlanExpectation[]
  artifactOutcomes StudentArtifactOutcome[]        @relation("StudentArtifactOutcome")
  studentProgress  StudentOutcomeProgress[]        @relation("StudentOutcomeProgress")
  unitPlans        UnitPlanExpectation[]

  @@index([subject, grade])
  @@index([code])
  @@index([strand, grade])
  @@index([subject, strand])
  @@index([subject, grade, strand])
}

model CurriculumExpectationEmbedding {
  id            String                @id @default(cuid())
  expectationId String                @unique
  embedding     Json
  model         String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  expectation   CurriculumExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)

  @@index([expectationId])
}

model LongRangePlan {
  id                             String                     @id @default(cuid())
  userId                         Int
  title                          String
  academicYear                   String
  term                           String?
  grade                          Int
  subject                        String
  description                    String?
  goals                          String?
  themes                         Json?
  overarchingQuestions           String?
  assessmentOverview             String?
  resourceNeeds                  String?
  professionalGoals              String?
  titleFr                        String?
  descriptionFr                  String?
  goalsFr                        String?
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  crossCurricularConnections     Json?
  culturalCelebrationIntegration Json?
  diagnosticAssessments          Json?
  differentationFramework        Json?
  endOfYearPerformanceTasks      Json?
  familyEngagementPlan           Json?
  formativeStrategies            Json?
  implementationFeasibility      Float?
  improvementAreas               Json?
  inclusiveMaterialsCalendar     Json?
  interventionTriggers           Json?
  lastOptimized                  DateTime?
  learningProgressions           Json?
  monthlyAdjustmentProtocols     Json?
  monthlyPreparationGuides       Json?
  nextYearRecommendations        Json?
  optimizationScore              Float?
  pedagogicalCertification       String?
  professionalDevelopmentPlan    Json?
  qualityVerificationData        Json?
  realWorldApplications          Json?
  researchComplianceScore        Float?
  resourceTimeline               Json?
  skillSpiraling                 Json?
  studentSuccessPredictions      Json?
  successfulStrategies           Json?
  summativeMilestones            Json?
  sustainedHooks                 Json?
  thematicConnections            Json?
  yearlyEngagementPlan           Json?
  yearlyEssentialQuestions       Json?
  yearlyTransferGoals            Json?
  differentiationFramework       String?
  thematicOverview               String?
  assessmentStrategy             String?
  differentiationPlans           String?
  indigenousPerspectives         String?
  resourceLibrary                String?
  parentCommunication            String?
  user                           User                       @relation(fields: [userId], references: [id])
  expectations                   LongRangePlanExpectation[]
  unitPlans                      UnitPlan[]

  @@index([userId, academicYear])
  @@index([userId, subject, grade])
  @@index([academicYear, grade, subject])
  @@index([userId, updatedAt])
  @@index([optimizationScore, pedagogicalCertification])
  @@index([lastOptimized])
  @@index([pedagogicalCertification])
  @@index([userId, optimizationScore])
  @@index([academicYear, subject, grade])
  @@index([userId, academicYear, subject])
}

model LongRangePlanExpectation {
  longRangePlanId String
  expectationId   String
  plannedTerm     String?
  longRangePlan   LongRangePlan         @relation(fields: [longRangePlanId], references: [id], onDelete: Cascade)
  expectation     CurriculumExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)

  @@id([longRangePlanId, expectationId])
}

model UnitPlan {
  id                         String                  @id @default(cuid())
  userId                     Int
  title                      String
  longRangePlanId            String
  description                String?
  bigIdeas                   String?
  essentialQuestions         Json?
  startDate                  DateTime
  endDate                    DateTime
  estimatedHours             Int?
  titleFr                    String?
  descriptionFr              String?
  bigIdeasFr                 String?
  assessmentPlan             String?
  successCriteria            Json?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  communityConnections       String?
  crossCurricularConnections String?
  culminatingTask            String?
  differentiationStrategies  Json?
  environmentalEducation     String?
  fieldTripsAndGuestSpeakers String?
  indigenousPerspectives     String?
  keyVocabulary              Json?
  learningSkills             Json?
  parentCommunicationPlan    String?
  priorKnowledge             String?
  socialJusticeConnections   String?
  technologyIntegration      String?
  assessmentRubric           Json?
  enduringUnderstandings     String?
  evidenceTypes              Json?
  performanceIndicators      Json?
  performanceTask            Json?
  transferableSkills         Json?
  isLocked                   Boolean                 @default(false)
  lockedAt                   DateTime?
  lockedReason               String?
  lessonPlans                ETFOLessonPlan[]
  longRangePlan              LongRangePlan           @relation(fields: [longRangePlanId], references: [id])
  user                       User                    @relation(fields: [userId], references: [id])
  expectations               UnitPlanExpectation[]
  resources                  UnitPlanResource[]
  transferSkills             UnitPlanTransferSkill[]

  @@index([userId, startDate])
  @@index([longRangePlanId])
  @@index([userId, updatedAt])
  @@index([startDate, endDate])
  @@index([longRangePlanId, startDate])
  @@index([userId, startDate, endDate])
}

model UnitPlanExpectation {
  unitPlanId    String
  expectationId String
  unitPlan      UnitPlan              @relation(fields: [unitPlanId], references: [id], onDelete: Cascade)
  expectation   CurriculumExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)

  @@id([unitPlanId, expectationId])
}

model UnitPlanResource {
  id         String   @id @default(cuid())
  unitPlanId String
  title      String
  type       String
  url        String?
  notes      String?
  createdAt  DateTime @default(now())
  unitPlan   UnitPlan @relation(fields: [unitPlanId], references: [id])
}

model ETFOLessonPlan {
  id                        String                      @id @default(cuid())
  userId                    Int
  title                     String
  unitPlanId                String
  date                      DateTime
  slotNumber                Int?                        @default(1)
  duration                  Int
  mindsOn                   String?
  action                    String?
  consolidation             String?
  learningGoals             String?
  materials                 Json?
  grouping                  String?
  titleFr                   String?
  mindsOnFr                 String?
  actionFr                  String?
  consolidationFr           String?
  learningGoalsFr           String?
  accommodations            Json?
  modifications             Json?
  extensions                Json?
  assessmentType            String?
  assessmentNotes           String?
  isSubFriendly             Boolean                     @default(true)
  subNotes                  String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  grade                     Int?
  language                  String?
  subject                   String?
  differentiationStrategies Json?
  engagementHooks           Json?
  formativeCheckpoints      Json?
  interventionStrategies    Json?
  performanceOpportunities  String?
  priorKnowledgeCheck       String?
  reflectionActivities      Json?
  wheretoFramework          Json?
  indigenousPerspectives    String?
  activityImports           ActivityImport[]
  daybookEntry              DaybookEntry?
  unitPlan                  UnitPlan                    @relation(fields: [unitPlanId], references: [id])
  user                      User                        @relation(fields: [userId], references: [id])
  expectations              ETFOLessonPlanExpectation[]
  resources                 ETFOLessonPlanResource[]
  lessonCompletions         LessonCompletion[]

  @@index([userId, date])
  @@index([unitPlanId])
  @@index([grade, subject])
  @@index([language])
  @@index([userId, isSubFriendly])
  @@index([userId, updatedAt])
  @@index([isSubFriendly, grade, subject])
  @@index([userId, grade, subject])
  @@index([grade, subject, date])
  @@index([userId, date, subject])
  @@index([userId, date, grade])
  @@index([date, duration])
  @@index([userId, assessmentType])
  @@index([userId, date, slotNumber])
}

model ETFOLessonPlanExpectation {
  lessonPlanId  String
  expectationId String
  lessonPlan    ETFOLessonPlan        @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  expectation   CurriculumExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)

  @@id([lessonPlanId, expectationId])
}

model ETFOLessonPlanResource {
  id           String         @id @default(cuid())
  lessonPlanId String
  title        String
  type         String
  url          String?
  content      String?
  createdAt    DateTime       @default(now())
  lessonPlan   ETFOLessonPlan @relation(fields: [lessonPlanId], references: [id])
}

model DaybookEntry {
  id                  String                    @id @default(cuid())
  userId              Int
  date                DateTime
  lessonPlanId        String?                   @unique
  whatWorked          String?
  whatDidntWork       String?
  nextSteps           String?
  classEngagement     String?
  commonChallenges    String?
  notableAchievements String?
  notes               String?
  privateNotes        String?
  whatWorkedFr        String?
  whatDidntWorkFr     String?
  nextStepsFr         String?
  notesFr             String?
  overallRating       Int?
  wouldReuseLesson    Boolean?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  user                User                      @relation(fields: [userId], references: [id])
  lessonPlan          ETFOLessonPlan?           @relation(fields: [lessonPlanId], references: [id])
  expectations        DaybookEntryExpectation[]

  @@index([userId, date])
  @@index([userId, overallRating])
  @@index([userId, updatedAt])
  @@index([lessonPlanId])
  @@index([userId, date, overallRating])
  @@index([date, overallRating])
  @@index([userId, wouldReuseLesson])
}

model DaybookEntryExpectation {
  daybookEntryId String
  expectationId  String
  coverage       String?
  daybookEntry   DaybookEntry          @relation(fields: [daybookEntryId], references: [id], onDelete: Cascade)
  expectation    CurriculumExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)

  @@id([daybookEntryId, expectationId])
}

model ExternalActivity {
  id              String                   @id @default(cuid())
  externalId      String
  source          String
  url             String
  title           String
  description     String?
  thumbnailUrl    String?
  duration        Int?
  activityType    String
  gradeMin        Int
  gradeMax        Int
  subject         String
  language        String                   @default("en")
  materials       Json
  technology      Json?
  groupSize       String?
  sourceRating    Float?
  sourceReviews   Int?
  internalRating  Float?
  internalReviews Int?
  curriculumTags  Json
  learningGoals   Json?
  isFree          Boolean                  @default(true)
  price           Float?
  license         String?
  lastVerified    DateTime                 @default(now())
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  collections     ActivityCollectionItem[]
  imports         ActivityImport[]
  ratings         ActivityRating[]

  @@unique([source, externalId])
  @@index([subject, gradeMin, gradeMax])
  @@index([activityType, language])
  @@index([isActive, lastVerified])
  @@index([isActive, subject, gradeMin, gradeMax])
  @@index([isActive, activityType, subject])
  @@index([internalRating, subject])
  @@index([isFree, subject, gradeMin, gradeMax])
}

model ActivityImport {
  id             String           @id @default(cuid())
  userId         Int
  activityId     String
  lessonPlanId   String?
  lessonSection  String?
  customizations Json?
  notes          String?
  timesUsed      Int              @default(1)
  lastUsed       DateTime         @default(now())
  effectiveness  Int?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id])
  activity       ExternalActivity @relation(fields: [activityId], references: [id])
  lessonPlan     ETFOLessonPlan?  @relation(fields: [lessonPlanId], references: [id])

  @@index([userId, activityId])
  @@index([lessonPlanId])
}

model ActivityRating {
  id             String           @id @default(cuid())
  userId         Int
  activityId     String
  rating         Int
  review         String?
  wouldRecommend Boolean?
  gradeUsed      Int?
  subjectUsed    String?
  workedWell     String?
  challenges     String?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id])
  activity       ExternalActivity @relation(fields: [activityId], references: [id])

  @@unique([userId, activityId])
  @@index([activityId, rating])
}

model ActivityCollection {
  id          String                   @id @default(cuid())
  userId      Int
  name        String
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  user        User                     @relation(fields: [userId], references: [id])
  items       ActivityCollectionItem[]

  @@index([userId])
}

model ActivityCollectionItem {
  collectionId String
  activityId   String
  addedAt      DateTime           @default(now())
  collection   ActivityCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  activity     ExternalActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([collectionId, activityId])
}

model WeeklyPlannerState {
  id                    String   @id @default(cuid())
  userId                Int      @unique
  defaultView           String   @default("week")
  timeSlotDuration      Int      @default(30)
  showWeekends          Boolean  @default(false)
  startOfWeek           Int      @default(1)
  workingHours          String   @default("{\"start\":\"08:00\",\"end\":\"16:00\"}")
  sidebarExpanded       Boolean  @default(true)
  showMiniCalendar      Boolean  @default(true)
  showResourcePanel     Boolean  @default(true)
  compactMode           Boolean  @default(false)
  theme                 String   @default("light")
  autoSave              Boolean  @default(true)
  autoSaveInterval      Int      @default(30)
  showUncoveredOutcomes Boolean  @default(true)
  defaultLessonDuration Int      @default(60)
  currentWeekStart      DateTime @default(now())
  lastActiveView        String?
  draftChanges          String?
  undoHistory           String   @default("[]")
  redoHistory           String   @default("[]")
  maxHistorySize        Int      @default(50)
  lastSyncedAt          DateTime @default(now())
  hasOfflineChanges     Boolean  @default(false)
  offlineData           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastSyncedAt])
  @@index([userId, hasOfflineChanges])
  @@index([currentWeekStart])
}

model PlanTemplate {
  id               String              @id @default(cuid())
  title            String
  titleFr          String?
  description      String?
  descriptionFr    String?
  type             String
  category         String
  subject          String?
  gradeMin         Int?
  gradeMax         Int?
  tags             Json
  keywords         Json
  isSystem         Boolean             @default(false)
  createdByUserId  Int?
  content          Json
  estimatedWeeks   Int?
  unitStructure    Json?
  estimatedMinutes Int?
  lessonStructure  Json?
  usageCount       Int                 @default(0)
  lastUsedAt       DateTime?
  averageRating    Float?              @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdByUser    User?               @relation(fields: [createdByUserId], references: [id])
  ratings          TemplateRating[]
  variations       TemplateVariation[]

  @@index([type, category])
  @@index([subject, gradeMin, gradeMax])
  @@index([isSystem])
  @@index([createdByUserId])
  @@index([usageCount])
  @@index([isSystem, averageRating])
  @@index([createdByUserId, type])
  @@index([lastUsedAt])
}

model TemplateRating {
  id         String       @id @default(cuid())
  templateId String
  userId     Int
  rating     Int
  comment    String?
  createdAt  DateTime     @default(now())
  template   PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([templateId, rating])
}

model TemplateVariation {
  id                String       @id @default(cuid())
  templateId        String
  name              String
  nameFr            String?
  description       String?
  modificationNotes String?
  content           Json
  createdAt         DateTime     @default(now())
  template          PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model RecentPlanAccess {
  id           String   @id @default(cuid())
  userId       Int
  planType     String
  planId       String
  lastAccessed DateTime @default(now())
  accessCount  Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planType, planId])
  @@index([userId, lastAccessed])
  @@index([planType, planId])
}

model Newsletter {
  id                    String    @id @default(cuid())
  userId                Int
  title                 String
  titleFr               String?
  dateFrom              DateTime
  dateTo                DateTime
  tone                  String
  templateType          String
  sections              Json
  metadata              Json?
  isDraft               Boolean   @default(true)
  sentAt                DateTime?
  focusAreas            Json?
  includeUpcomingEvents Boolean   @default(true)
  lessonPlansUsed       Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDraft])
  @@index([userId, sentAt])
  @@index([dateFrom, dateTo])
  @@index([userId, dateFrom, dateTo])
  @@index([isDraft, sentAt])
  @@index([userId, createdAt])
}

model SubstitutePlan {
  id                  String    @id @default(cuid())
  userId              Int
  title               String
  dateFor             DateTime
  grade               Int?
  subject             String?
  schedule            Json
  classroomRoutines   Json
  emergencyInfo       Json
  lessonPlans         Json
  behaviorPlan        Json
  studentNotes        Json
  materialsList       Json
  importantInfo       Json?
  sourceUnitPlanId    String?
  sourceLessonPlanIds Json?
  generationContext   Json?
  teacherContact      Json?
  adminContact        Json?
  isActive            Boolean   @default(true)
  lastUsed            DateTime?
  useCount            Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateFor])
  @@index([userId, isActive])
  @@index([grade, subject])
  @@index([userId, dateFor, grade])
  @@index([dateFor, grade, subject])
  @@index([isActive, dateFor])
  @@index([userId, isActive, dateFor])
}

model PerformanceTaskTemplate {
  id             String   @id @default(cuid())
  userId         Int
  title          String
  subject        String
  gradeMin       Int
  gradeMax       Int
  scenario       String
  role           String
  audience       String
  format         String
  rubricTemplate Json?
  isPublic       Boolean  @default(false)
  timesUsed      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject, gradeMin, gradeMax])
  @@index([isPublic, subject])
}

model EssentialQuestionTemplate {
  id            String   @id @default(cuid())
  question      String   @unique
  subject       String
  gradeMin      Int
  gradeMax      Int
  category      String
  bloomsLevel   String?
  cognitiveLoad String?  @default("medium")
  timesUsed     Int      @default(0)
  rating        Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subject, gradeMin, gradeMax])
  @@index([category, bloomsLevel])
  @@index([rating])
}

model TransferSkillTemplate {
  id                    String                  @id @default(cuid())
  skillName             String
  description           String
  category              String
  gradeMin              Int
  gradeMax              Int
  performanceIndicators Json?
  assessmentMethods     Json?
  isCore                Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  unitPlans             UnitPlanTransferSkill[]

  @@index([category])
  @@index([gradeMin, gradeMax])
  @@index([isCore])
}

model UnitPlanTransferSkill {
  unitPlanId      String
  transferSkillId String
  emphasis        String                @default("developing")
  unitPlan        UnitPlan              @relation(fields: [unitPlanId], references: [id], onDelete: Cascade)
  transferSkill   TransferSkillTemplate @relation(fields: [transferSkillId], references: [id], onDelete: Cascade)

  @@id([unitPlanId, transferSkillId])
}

model Student {
  id                String                   @id @default(cuid())
  userId            Int
  firstName         String
  lastName          String
  studentId         String?                  @unique
  studentNumber     String?
  dateOfBirth       DateTime?
  grade             Int
  program           String?
  homeroom          String?
  hasIEP            Boolean                  @default(false)
  iepGoals          Json?
  accommodations    Json?
  specialNeeds      String?
  parentContact     Json?
  enrollmentDate    DateTime                 @default(now())
  withdrawalDate    DateTime?
  isActive          Boolean                  @default(true)
  status            String                   @default("active")
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  uploadedArtifacts Artifact[]
  assessments       Assessment[]
  reports           Report[]
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts         StudentArtifact[]
  outcomeProgress   StudentOutcomeProgress[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, grade])
  @@index([grade, isActive])
  @@index([studentNumber])
  @@index([studentId])
  @@index([status])
}

model StudentArtifact {
  id                    String                   @id @default(cuid())
  studentId             String
  userId                Int
  artifactType          String
  title                 String
  description           String?
  filePath              String?
  fileName              String?
  fileSize              Int?
  mimeType              String?
  textContent           String?
  metadata              Json?
  checksum              String?
  thumbnailPath         String?
  thumbnailUrl          String?
  collectionContext     String?
  dateCollected         DateTime                 @default(now())
  isPrivate             Boolean                  @default(false)
  isArchived            Boolean                  @default(false)
  tags                  Json?
  processingStatus      String                   @default("PENDING")
  processingError       String?
  processingCompletedAt DateTime?
  lastAssessedDate      DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student               Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  outcomes              StudentArtifactOutcome[]

  @@index([studentId])
  @@index([userId])
  @@index([studentId, dateCollected])
  @@index([artifactType])
  @@index([userId, dateCollected])
  @@index([processingStatus])
  @@index([studentId, artifactType])
  @@index([checksum])
  @@index([isArchived])
  @@index([studentId, userId, checksum])
}

model StudentArtifactOutcome {
  artifactId        String
  outcomeId         String
  evidenceType      String
  teacherNote       String?
  confidenceLevel   String                @default("MEDIUM")
  contextualFactors String?
  dateAssessed      DateTime              @default(now())
  outcome           CurriculumExpectation @relation("StudentArtifactOutcome", fields: [outcomeId], references: [id], onDelete: Cascade)
  artifact          StudentArtifact       @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([artifactId, outcomeId])
  @@index([outcomeId])
  @@index([evidenceType])
  @@index([dateAssessed])
  @@index([confidenceLevel])
}

model StudentOutcomeProgress {
  id                  String                @id @default(cuid())
  studentId           String
  outcomeId           String
  userId              Int
  currentLevel        String                @default("NOT_YET")
  previousLevel       String?
  lastAssessmentDate  DateTime              @default(now())
  lastAssessedDate    DateTime?
  totalEvidencePieces Int                   @default(0)
  strongestEvidence   Json?
  areasForGrowth      String?
  strengths           String?
  teacherNotes        String?
  parentShared        Boolean               @default(false)
  parentShareDate     DateTime?
  isArchived          Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome             CurriculumExpectation @relation("StudentOutcomeProgress", fields: [outcomeId], references: [id], onDelete: Cascade)
  student             Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, outcomeId])
  @@index([studentId])
  @@index([outcomeId])
  @@index([userId])
  @@index([currentLevel])
  @@index([lastAssessmentDate])
  @@index([studentId, currentLevel])
  @@index([outcomeId, currentLevel])
  @@index([userId, lastAssessmentDate])
  @@index([parentShared])
}

model Assessment {
  id              String   @id @default(cuid())
  studentId       String
  teacherId       Int
  subject         String
  expectation     String
  expectationCode String?
  level           String
  evidenceType    String
  description     String?
  notes           String?
  artifacts       Json?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  teacher         User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([subject])
  @@index([level])
  @@index([evidenceType])
  @@index([date])
  @@index([studentId, subject])
  @@index([studentId, date])
}

model Report {
  id             String   @id @default(cuid())
  type           String
  title          String
  studentId      String?
  teacherId      Int
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  subjects       Json?
  format         String
  status         String   @default("draft")
  url            String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  teacher        User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student        Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([studentId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Artifact {
  id               String   @id @default(cuid())
  filename         String
  originalName     String
  mimeType         String
  size             Int
  url              String
  thumbnailUrl     String?
  studentId        String?
  assessmentId     String?
  uploadedBy       Int
  processingStatus String   @default("pending")
  tags             Json?
  description      String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  uploader         User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  student          Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([assessmentId])
  @@index([uploadedBy])
  @@index([processingStatus])
  @@index([createdAt])
}

model LessonCompletion {
  id             String         @id @default(cuid())
  userId         Int
  lessonId       String         
  completedAt    DateTime       @default(now())
  notes          String?
  actualDuration Int?
  wentWell       Boolean        @default(true)
  needsFollowUp  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         ETFOLessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([completedAt])
  @@index([userId, completedAt])
}
