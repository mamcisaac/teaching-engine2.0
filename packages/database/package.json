{
  "name": "@teaching-engine/database",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-grade1-curriculum.ts && tsx prisma/seed-long-range-plans.ts",
    "db:seed:curriculum": "tsx prisma/seed-grade1-curriculum.ts",
    "db:seed:plans": "tsx prisma/seed-long-range-plans.ts",
    "db:seed:all": "tsx prisma/seed.ts && tsx prisma/seed-grade1-curriculum.ts && tsx prisma/seed-long-range-plans.ts",
    "db:seed:test": "tsx prisma/seed.ts",
    "db:seed:integration": "tsx prisma/seed-integration.ts",
    "db:seed:api-tests": "tsx prisma/seed-api-tests.ts",
    "db:seed:frontend": "tsx prisma/seed-frontend.ts",
    "db:seed:security": "tsx prisma/seed-security.ts",
    "db:seed:coverage": "tsx prisma/seed-coverage.ts",
    "db:seed:performance": "tsx prisma/seed-performance.ts",
    "postinstall": "node -e \"if (!process.env.SKIP_PRISMA_GENERATE && !process.env.npm_lifecycle_event?.includes('dev')) { require('child_process').execSync('prisma generate', {stdio: 'inherit'}); }\"",
    "migrate:etfo": "tsx src/migrations/migrate-to-etfo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
