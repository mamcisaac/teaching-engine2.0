{
  "name": "client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quick": "vitest run --reporter=dot --bail=1",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:real-backend": "vitest run --config vitest.real-backend.config.ts",
    "test:real-backend:watch": "vitest watch --config vitest.real-backend.config.ts",
    "test:real-backend:full": "node scripts/run-real-backend-tests.js",
    "test:contract": "vitest run --config vitest.integration.config.ts src/__tests__/contract/",
    "test:pact": "vitest run --config vitest.pact.config.ts",
    "test:pact:publish": "pact-broker publish ./pacts --consumer-app-version $npm_package_version --broker-base-url ${PACT_BROKER_URL:-http://localhost:9292} --broker-username ${PACT_BROKER_USERNAME:-} --broker-password ${PACT_BROKER_PASSWORD:-}",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:real-backend",
    "test:mutation": "stryker run",
    "test:mutation:components": "stryker run --mutate 'src/components/**/*.{ts,tsx}'",
    "test:mutation:hooks": "stryker run --mutate 'src/hooks/**/*.{ts,tsx}'",
    "test:mutation:utils": "stryker run --mutate 'src/utils/**/*.{ts,tsx}'",
    "test:mutation:services": "stryker run --mutate 'src/services/**/*.{ts,tsx}'",
    "test:mutation:stores": "stryker run --mutate 'src/stores/**/*.{ts,tsx}'",
    "test:mutation:api": "stryker run --mutate 'src/api/**/*.{ts,tsx}'",
    "test:mutation:report": "stryker run --reporters html,clear-text,progress",
    "test:mutation:quick": "stryker run --maxConcurrentTestRunners 1 --timeoutMS 20000",
    "test:mutation:ci": "stryker run --maxConcurrentTestRunners 1 --reporters clear-text,progress --logLevel error",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../.eslintrc.json \"src/**/*.{ts,tsx,js,jsx}\"",
    "analyze": "node scripts/bundle-analyzer.js",
    "analyze:build": "npm run build && npm run analyze"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sentry/react": "^9.35.0",
    "@sentry/replay": "^7.116.0",
    "@sentry/tracing": "^7.120.3",
    "@tanstack/react-query": "^5.81.2",
    "@types/dompurify": "^3.2.0",
    "@types/react-big-calendar": "^1.16.2",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "dompurify": "^3.2.6",
    "framer-motion": "^12.19.1",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.517.0",
    "moment": "^2.30.1",
    "nanoid": "^3.3.11",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-chartjs-2": "^5.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.58.1",
    "react-router-dom": "^6.30.1",
    "react-to-print": "^3.1.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "zod": "3.25.58",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-constant-elements": "^7.27.1",
    "@babel/plugin-transform-react-inline-elements": "^7.27.1",
    "@pact-foundation/pact": "^13.1.2",
    "@pact-foundation/pact-node": "^10.18.0",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/html-reporter": "^3.1.0",
    "@stryker-mutator/javascript-mutator": "^4.0.0",
    "@stryker-mutator/typescript-checker": "^9.0.1",
    "@stryker-mutator/vitest-runner": "^9.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/recharts": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "canvas": "^3.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "glob": "^11.0.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^24.1.3",
    "msw": "^2.10.3",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.4"
  }
}
