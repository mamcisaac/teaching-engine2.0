{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "ignorePatterns": [
    "dist",
    "build",
    "coverage",
    "node_modules",
    "*.config.js",
    "*.config.ts",
    "**/*.config.js",
    "**/.eslintrc.js",
    "**/*.eslintrc.js",
    "**/jest-*.js",
    "**/simple-server.js",
    "**/validate-*.js",
    "**/*.d.ts",
    "packages/database/src/generated",
    "**/analytics/**/*",
    "client/src/utils/analyticsExport.ts",
    "server/src/routes/analytics.ts",
    "packages/database/prisma/seed.ts",
    "packages/database/prisma/seed-*.ts",
    "playwright.config.ci.ts",
    "playwright.config.full.ts",
    "scripts/**/*",
    "server/scripts/**/*",
    "client/scripts/**/*",
    "server/tests/**/*",
    "client/tests/**/*",
    "tests/**/*",
    "**/__tests__/**/*",
    "**/__mocks__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/test-utils/**/*",
    "**/mocks/**/*",
    "jest.*.js",
    "jest.*.ts",
    "vitest.*.ts",
    "test-*.js",
    "test-*.cjs",
    "*.test.js",
    "*.test.cjs",
    "server/client/**/*",
    "client/public/service-worker.js",
    "server/src/utils/errors.ts",
    "server/src/utils/performance.ts",
    "server/src/utils/routeFactory.ts",
    "server/src/utils/urlValidator.ts",
    "server/src/middleware/rateLimit/**/*",
    "server/src/utils/database.ts",
    "claude-code-flow/**/*",
    "server/.eslintrc.real-implementation.js"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/explicit-function-return-type": "error",
    "@typescript-eslint/no-misused-promises": "error",
    "@typescript-eslint/require-await": "error",
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "react-hooks/exhaustive-deps": "warn",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-unused-vars": "off",
    "no-case-declarations": "error"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parserOptions": {
        "project": [
          "./tsconfig.json",
          "./client/tsconfig.json",
          "./server/tsconfig.json",
          "./packages/database/tsconfig.json"
        ]
      }
    },
    {
      "files": ["**/logger.ts", "**/logger.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
