#!/bin/sh
# Real Implementation Testing Pre-commit Hook

echo "🔍 Real Implementation Testing Quality Checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Exit on any error
set -e

# Function to print colored output
print_status() {
    echo -e "${BLUE}[$(date +'%H:%M:%S')]${NC} $1"
}

print_success() {
    echo -e "${GREEN}✅${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠️${NC} $1"
}

print_error() {
    echo -e "${RED}❌${NC} $1"
}

# Get list of staged test files
STAGED_TEST_FILES=$(git diff --cached --name-only | grep -E '\.(test|spec)\.ts$' || true)

if [ -z "$STAGED_TEST_FILES" ]; then
    print_status "No test files staged for commit"
    exit 0
fi

print_status "Found staged test files:"
echo "$STAGED_TEST_FILES"

# 1. Validate Test Quality Standards
print_status "Validating test quality standards..."

# Check if validate-quality script exists
if ! pnpm --filter server run test:validate-quality --help > /dev/null 2>&1; then
    print_warning "Test quality validation script not found, creating temporary validator..."
    
    # Create temporary validator
    cat > temp-quality-validator.js << 'EOF'
const fs = require('fs');
const path = require('path');

const testFiles = process.argv.slice(2);
let hasErrors = false;

testFiles.forEach(file => {
    if (!fs.existsSync(file)) return;
    
    const content = fs.readFileSync(file, 'utf-8');
    const issues = [];
    
    // Check for Real Implementation identifier
    if (!content.includes('Real Implementation')) {
        issues.push('Missing "Real Implementation" in describe block');
    }
    
    // Check for performance monitoring
    if (!content.includes('performanceManager') && !content.includes('measureTestPerformance')) {
        issues.push('Missing performance monitoring');
    }
    
    // Check for proper cleanup
    if ((content.includes('prisma') || content.includes('testDb')) && 
        !content.includes('afterEach') && !content.includes('cleanup')) {
        issues.push('Missing database cleanup');
    }
    
    // Check for realistic test data
    if (content.includes('{ id: 1') || content.includes('"test@example.com"')) {
        issues.push('Using hardcoded test data instead of generators');
    }
    
    // Check for forbidden mocking patterns
    if (content.includes('jest.mock') && content.includes('/services/')) {
        issues.push('Mocking internal services is not allowed');
    }
    
    if (issues.length > 0) {
        console.error(`\n❌ Quality issues in ${file}:`);
        issues.forEach(issue => console.error(`  - ${issue}`));
        hasErrors = true;
    } else {
        console.log(`✅ ${file} passes quality checks`);
    }
});

if (hasErrors) {
    console.error('\n❌ Test quality validation failed');
    process.exit(1);
} else {
    console.log('\n✅ All tests pass quality validation');
}
EOF

    node temp-quality-validator.js $STAGED_TEST_FILES
    rm temp-quality-validator.js
else
    # Use existing validation script
    echo "$STAGED_TEST_FILES" | xargs pnpm --filter server run test:validate-quality
fi

print_success "Test quality validation passed"

# 2. ESLint Real Implementation Rules
print_status "Running ESLint real implementation rules..."

# Check if our custom ESLint config exists
if [ -f ".eslintrc.real-implementation.js" ]; then
    echo "$STAGED_TEST_FILES" | xargs npx eslint --config .eslintrc.real-implementation.js --no-ignore
    print_success "ESLint real implementation rules passed"
else
    print_warning "Custom ESLint config not found, using basic checks..."
    
    # Basic pattern checking
    for file in $STAGED_TEST_FILES; do
        if [ -f "$file" ]; then
            # Check for jest.mock in integration tests
            if echo "$file" | grep -q "integration" && grep -q "jest.mock" "$file"; then
                print_error "Found jest.mock in integration test: $file"
                exit 1
            fi
            
            # Check for Real Implementation in describe
            if ! grep -q "Real Implementation" "$file"; then
                print_error "Missing 'Real Implementation' in describe block: $file"
                exit 1
            fi
        fi
    done
    
    print_success "Basic ESLint checks passed"
fi

# 3. Performance Check for Modified Tests
print_status "Checking performance impact of modified tests..."

# Create temporary performance checker
cat > temp-performance-checker.js << 'EOF'
const fs = require('fs');

const testFiles = process.argv.slice(2);
let hasPerformanceIssues = false;

testFiles.forEach(file => {
    if (!fs.existsSync(file)) return;
    
    const content = fs.readFileSync(file, 'utf-8');
    const lines = content.split('\n');
    
    // Check for potential performance issues
    const issues = [];
    
    // Check for database operations without batching
    if (content.includes('createMany') && !content.includes('batch')) {
        issues.push('Consider batching database operations for better performance');
    }
    
    // Check for missing performance timeouts
    const hasAsyncTests = content.includes('async ()') || content.includes('await ');
    const hasTimeout = content.includes('timeout') || content.includes('jest.setTimeout');
    
    if (hasAsyncTests && !hasTimeout) {
        issues.push('Async tests should have explicit timeouts');
    }
    
    // Check for potential memory leaks
    if (content.includes('setInterval') && !content.includes('clearInterval')) {
        issues.push('Potential memory leak: setInterval without clearInterval');
    }
    
    if (issues.length > 0) {
        console.warn(`\n⚠️  Performance concerns in ${file}:`);
        issues.forEach(issue => console.warn(`  - ${issue}`));
    } else {
        console.log(`✅ ${file} has no obvious performance issues`);
    }
});
EOF

node temp-performance-checker.js $STAGED_TEST_FILES
rm temp-performance-checker.js

print_success "Performance check completed"

# 4. Type Safety Check
print_status "Checking TypeScript types in test files..."

echo "$STAGED_TEST_FILES" | xargs npx tsc --noEmit --skipLibCheck

print_success "TypeScript type checking passed"

# 5. Test File Structure Validation
print_status "Validating test file structure..."

for file in $STAGED_TEST_FILES; do
    if [ -f "$file" ]; then
        # Check for proper imports
        if ! grep -q "import.*test.*utils\|import.*testUtils" "$file"; then
            if grep -q "prisma\|database" "$file"; then
                print_warning "Test file $file uses database but may be missing test utilities import"
            fi
        fi
        
        # Check for describe block structure
        if ! grep -q "describe.*Real Implementation" "$file"; then
            print_error "Test file $file must have describe block with 'Real Implementation'"
            exit 1
        fi
        
        # Check for proper test structure (beforeEach, afterEach)
        if grep -q "prisma\|testDb" "$file"; then
            if ! grep -q "beforeEach\|beforeAll" "$file"; then
                print_warning "Database test $file should have setup in beforeEach/beforeAll"
            fi
            
            if ! grep -q "afterEach\|afterAll" "$file"; then
                print_error "Database test $file must have cleanup in afterEach/afterAll"
                exit 1
            fi
        fi
    fi
done

print_success "Test file structure validation passed"

# 6. Documentation Check
print_status "Checking for test documentation requirements..."

for file in $STAGED_TEST_FILES; do
    if [ -f "$file" ]; then
        # Check for complex tests that need documentation
        test_count=$(grep -c "it\|test" "$file" || echo "0")
        
        if [ "$test_count" -gt 10 ]; then
            if ! grep -q "\/\*\*\|\/\/" "$file"; then
                print_warning "Complex test file $file ($test_count tests) should include documentation comments"
            fi
        fi
        
        # Check for performance test documentation
        if grep -q "performance\|benchmark" "$file"; then
            if ! grep -q "@performance\|Performance:" "$file"; then
                print_warning "Performance test $file should document performance expectations"
            fi
        fi
    fi
done

print_success "Documentation check completed"

# 7. Security Check for Test Data
print_status "Checking for security issues in test data..."

for file in $STAGED_TEST_FILES; do
    if [ -f "$file" ]; then
        # Check for hardcoded secrets or sensitive data
        if grep -qi "password.*:\s*['\"].*['\"]" "$file"; then
            if ! grep -qi "test\|fake\|mock" "$file"; then
                print_error "Potential hardcoded password found in $file"
                exit 1
            fi
        fi
        
        # Check for real email addresses
        if grep -q "@[a-zA-Z0-9.-]\+\.[a-zA-Z]\{2,\}" "$file"; then
            if ! grep -q "@example\|@test\|@fake" "$file"; then
                print_warning "Real email addresses found in $file - consider using test domains"
            fi
        fi
        
        # Check for potential API keys
        if grep -qi "api[_-]key\|apikey\|secret[_-]key" "$file"; then
            if ! grep -qi "test\|fake\|mock" "$file"; then
                print_error "Potential real API key found in $file"
                exit 1
            fi
        fi
    fi
done

print_success "Security check passed"

# 8. Final Summary
print_status "Pre-commit checks summary:"
print_success "✅ Test quality standards validated"
print_success "✅ ESLint real implementation rules passed"
print_success "✅ Performance impact assessed"
print_success "✅ TypeScript types validated"
print_success "✅ Test file structure verified"
print_success "✅ Documentation requirements checked"
print_success "✅ Security scan completed"

echo ""
print_success "🎉 All real implementation testing quality checks passed!"
print_status "You can now commit your changes with confidence."

exit 0