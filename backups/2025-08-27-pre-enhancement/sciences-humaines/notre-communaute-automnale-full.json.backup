    {
      "lessonNumber": 1,
      "lessonType": "core",
      "title": "Notre école dans la communauté",
      "progression": "Leçon de base: Introduction à l'école comme partie intégrante de la communauté automnale",
      "oneGoal": "Students will identify their school as an important part of their local autumn community",
      "duration": 45,
      "keyVocabulary": [
        "communauté",
        "école",
        "voisins"
      ],
      "opening": {
        "duration": 8,
        "activity": "Community circle where students look out classroom windows and share what they see in their school neighborhood. Introduce the word 'communauté' with wide arm gestures showing connection.",
        "materials": [
          "window access or school photos",
          "community connection gestures",
          "autumn background music"
        ],
        "visualSupports": "Wide arm gestures for community, pointing outward for neighborhood, heart hands for belonging",
        "decisionPoints": [
          "Decision Point 1: Observer l'engagement des élèves à regarder par les fenêtres, si faible alors encourager la curiosité avec des questions directrices sur ce qu'ils voient",
          "Decision Point 2: Observer la compréhension du mot 'communauté', si limitée alors utiliser des gestes concrets et des exemples de personnes qui travaillent ensemble",
          "Decision Point 3: Observer le sentiment d'appartenance à la communauté scolaire, si faible alors renforcer avec des exemples positifs d'accueil et de sécurité"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Walk around room like different community helpers - march like police officers, deliver like mail carriers, sweep like janitors (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show autumn activities in community - rake leaves motion, pick apples, zip up jackets for cooler weather (30 seconds)",
            "duration": 30
          }
        ]
      },
      "main": {
        "duration": 27,
        "activity": "School community exploration using school maps and autumn neighborhood photos. Students create a 'Our School Community' poster, drawing or pasting pictures of places and people they see around school in autumn. Emphasize how school connects to neighborhood.",
        "materials": [
          "school area maps",
          "autumn neighborhood photos",
          "poster paper",
          "drawing supplies",
          "glue sticks"
        ],
        "visualSupports": "Connecting gestures between school and community, proud posture for school belonging, discovery expressions",
        "decisionPoints": [
          "Decision Point 1: Observer la familiarité des élèves avec les environs de leur école, si familiers alors encourager le partage d'endroits spécifiques connus et visités avec les familles, sinon utiliser photos et cartes pour introduire les lieux communautaires",
          "Decision Point 2: Observer quels monuments communautaires les élèves peuvent voir des fenêtres de l'école, si visibles alors pointer et expliquer les connexions, sinon utiliser des photos des monuments proches",
          "Decision Point 3: Observer si les élèves ne comprennent pas comment l'école se connecte à la communauté, si confusion alors utiliser des exemples concrets comme la livraison du courrier et les autobus scolaires"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Walk around room like different community helpers - march like police officers, deliver like mail carriers, sweep like janitors (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show autumn activities in community - rake leaves motion, pick apples, zip up jackets for cooler weather (30 seconds)",
            "duration": 30
          }
        ]
      },
      "closing": {
        "duration": 10,
        "activity": "Community belonging circle where students share one thing they like about their school being part of the community. End with group chant: 'Notre école fait partie de notre communauté!'",
        "materials": [],
        "visualSupports": "",
        "decisionPoints": [
          "Decision Point 1: Observer l'enthousiasme des élèves à partager ce qu'ils aiment de leur communauté scolaire, si faible alors encourager avec des prompts spécifiques",
          "Decision Point 2: Observer la participation au chant de groupe, si limitée alors modéliser avec enthousiasme et réduire la pression de performance",
          "Decision Point 3: Observer le sentiment d'appartenance exprimé, si faible alors renforcer individuellement les connexions positives à l'école"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Walk around room like different community helpers - march like police officers, deliver like mail carriers, sweep like janitors (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show autumn activities in community - rake leaves motion, pick apples, zip up jackets for cooler weather (30 seconds)",
            "duration": 30
          }
        ]
      },
      "troubleshooting": {
        "ifStrugglingWith": "Students not understanding how school connects to community",
        "then": "Use concrete examples like mail delivery to school, school buses in neighborhood, families walking to school"
      },
      "realWorldConnection": "Our school is connected to many community helpers and neighbors who work together in autumn",
      "differentiation": {
        "forStruggling": [
          "Use simple hand-drawn school maps with clear icons",
          "Point out school windows to show immediate school-community connections",
          "Use 'our school belongs here' gestures and simple phrases",
          "Start with what students can see from classroom before expanding to community"
        ],
        "forAdvanced": [
          "Create detailed school-community connection diagrams showing roads, walkways, and shared spaces",
          "Interview older students about how they travel between school and community",
          "Design a 'school community welcome guide' for new families",
          "Map all the ways community members visit or support the school"
        ],
        "forELL": [
          "Connect school words to home language equivalents",
          "Use family photos showing travel to school through community",
          "Encourage families to share their own school-community connection stories",
          "Use multilingual community signage as concrete examples"
        ],
        "forIEP": [
          "Use tactile school models or raised maps for spatial understanding",
          "Provide photo sequences showing school-to-community journey",
          "Allow alternative ways to show school belonging (drawing, gestures, or using assistive devices)",
          "Break school-community connections into very concrete, observable steps"
        ]
      },
      "assessmentCriteria": {
        "observable": [
          "Student points to or names places they see around the school",
          "Student uses gestures or words to show school belongs in community",
          "Student connects their school experience to neighborhood (buses, walking, parent drop-off)",
          "Student participates in creating the 'Our School Community' poster"
        ],
        "checkpoints": [
          "Opening: Can student look out window and identify school neighborhood?",
          "Main activity: Does student place school correctly in relation to community on poster?",
          "Closing: Can student say or show that their école (school) is part of their communauté?",
          "Observation: Student demonstrates understanding that school connects to wider community"
        ]
      },
      "emergencyBackup": {
        "techFails": "Si vidéos indisponibles, raconter histoires avec images",
        "materialsMissing": "Si cartes manquantes, dessiner plans simples au tableau",
        "studentsOverwhelmed": "Si concepts complexes, focus sur expérience personnelle",
        "timeShort": "Partage rapide d'une découverte importante"
