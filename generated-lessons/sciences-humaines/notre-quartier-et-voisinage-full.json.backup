    {
      "lessonNumber": 1,
      "lessonType": "core",
      "title": "Qu'est-ce qu'un quartier?",
      "progression": "Leçon de base: Introduction au concept de quartier comme communauté résidentielle de base",
      "oneGoal": "Students will understand what a neighborhood is and identify the basic elements that make up their local area",
      "duration": 45,
      "keyVocabulary": [
        "quartier",
        "voisinage",
        "maison"
      ],
      "opening": {
        "duration": 8,
        "activity": "Neighborhood circle where students share one thing they see when they walk outside their home. Introduce the word 'quartier' with welcoming, expansive gestures that suggest community connection.",
        "materials": [
          "neighborhood photos from various communities",
          "community sound effects",
          "welcome music"
        ],
        "visualSupports": "Open arms for community inclusion, pointing gestures for exploration, wide circle for neighborhood concept",
        "decisionPoints": [
          "Decision Point 1: Observer l'engagement des élèves à partager ce qu'ils voient dehors de chez eux, si hésitant alors encourager avec questions spécifiques et exemples",
          "Decision Point 2: Observer la compréhension du mot 'quartier', si limitée alors utiliser des gestes expansifs et des exemples visuels concrets",
          "Decision Point 3: Observer le sentiment de sécurité et de positivité envers leur quartier, si faible alors se concentrer sur les éléments universels positifs"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Explore around classroom like exploring our neighborhood - walk carefully, look at houses, wave to neighbors (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show directions with body - point north, south, east, west, turn to face different directions like navigating neighborhood (30 seconds)",
            "duration": 30
          }
        ]
      },
      "main": {
        "duration": 27,
        "activity": "Neighborhood exploration using aerial photos and neighborhood picture books. Students create a 'What Makes a Neighborhood' anchor chart, identifying homes, streets, people, and places. Build understanding that neighborhoods are collections of homes where people live together as a community.",
        "materials": [
          "aerial neighborhood photos",
          "neighborhood books",
          "anchor chart paper",
          "markers",
          "building blocks for 3D modeling"
        ],
        "visualSupports": "Pointing to neighborhood elements, building gestures for homes, walking motions for streets, people connections for community",
        "decisionPoints": [
          "Decision Point 1: Observer la familiarité des élèves avec leur quartier immédiat, si familiers alors utiliser des exemples locaux spécifiques, sinon utiliser des concepts généraux de quartier",
          "Decision Point 2: Observer s'il faut commencer par la zone scolaire ou les zones domiciliaires, si scolaire alors commencer par le quartier de l'école comme expérience partagée, sinon commencer par les quartiers domiciliaires",
          "Decision Point 3: Observer si les élèves ne se sentent pas en sécurité ou positifs envers leur quartier, si oui alors se concentrer sur les éléments universels positifs"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Explore around classroom like exploring our neighborhood - walk carefully, look at houses, wave to neighbors (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show directions with body - point north, south, east, west, turn to face different directions like navigating neighborhood (30 seconds)",
            "duration": 30
          }
        ]
      },
      "closing": {
        "duration": 10,
        "activity": "Neighborhood appreciation circle where students share one word that describes their neighborhood. End with group chant: 'Mon quartier est spécial!'",
        "materials": [],
        "visualSupports": "",
        "decisionPoints": [
          "Decision Point 1: Observer l'enthousiasme des élèves à partager un mot décrivant leur quartier, si faible alors fournir des exemples de mots positifs",
          "Decision Point 2: Observer la participation au chant de groupe, si limitée alors modéliser avec enthousiasme et permettre la participation silencieuse",
          "Decision Point 3: Observer le sentiment de fierté envers leur quartier exprimé, si faible alors souligner les aspects spéciaux et uniques de chaque quartier"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Explore around classroom like exploring our neighborhood - walk carefully, look at houses, wave to neighbors (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show directions with body - point north, south, east, west, turn to face different directions like navigating neighborhood (30 seconds)",
            "duration": 30
          }
        ]
      },
      "troubleshooting": {
        "ifStrugglingWith": "Students who don't feel safe or positive about their neighborhood",
        "then": "Focus on universal positive elements like having a place to live and belonging to a community"
      },
      "realWorldConnection": "Understanding our neighborhood helps us feel safe and connected to our community",
      "differentiation": {
        "forStruggling": [
          "Commencer avec 'Ma maison est ici' en montrant une photo simple",
          "Utiliser seulement 2-3 éléments de quartier (maisons, rue)",
          "Permettre de pointer au lieu d'expliquer verbalement",
          "Utiliser des livres d'images avec quartiers simples et familiers"
        ],
        "forAdvanced": [
          "Créer une liste détaillée d'éléments qui font un bon quartier",
          "Comparer différents types de quartiers (ville, banlieue, campagne)",
          "Expliquer comment les quartiers changent selon les saisons",
          "Dessiner le quartier idéal avec des éléments spéciaux"
        ],
        "forELL": [
          "Apprendre 'quartier' dans la langue maternelle d'abord",
          "Utiliser des images de quartiers de différents pays",
          "Connecter 'neighborhood' à des concepts familiers du pays d'origine",
          "Permettre de décrire en langue maternelle puis traduire"
        ],
        "forIEP": [
          "Utiliser des supports tactiles pour explorer le concept de quartier",
          "Adapter la discussion selon les besoins sensoriels",
          "Utiliser la communication alternative pour partager sur le quartier",
          "Offrir des options calmes si le groupe est trop stimulant"
        ]
      },
      "assessmentCriteria": {
        "observable": [
          "L'élève peut identifier ce qui fait un quartier (maisons, rues, personnes)",
          "L'élève utilise le mot 'quartier' en parlant",
          "L'élève participe aux discussions sur les éléments du quartier",
          "L'élève contribue au tableau d'ancrage 'Qu'est-ce qui fait un quartier'"
        ],
        "checkpoints": [
          "Mi-leçon: L'élève peut nommer 2 éléments d'un quartier",
          "Fin de leçon: L'élève explique ce qui fait un quartier",
          "Preuve portfolio: Dessin des éléments du quartier par l'élève",
          "Observation: L'élève démontre la compréhension du concept de quartier"
        ]
      },
      "emergencyBackup": {
        "techFails": "Si vidéos indisponibles, raconter histoires avec images",
        "materialsMissing": "Si cartes manquantes, dessiner plans simples au tableau",
        "studentsOverwhelmed": "Si concepts complexes, focus sur expérience personnelle",
        "timeShort": "Partage rapide d'une découverte importante"
      }
