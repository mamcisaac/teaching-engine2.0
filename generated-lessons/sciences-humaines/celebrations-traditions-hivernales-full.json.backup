  "lessons": [
    {
      "lessonNumber": 1,
      "lessonType": "core",
      "title": "Bienvenue dans notre monde d'hiver",
      "progression": "Leçon de base: Introduction aux traditions familiales et à l'identité culturelle dans notre communauté hivernale",
      "oneGoal": "",
      "duration": "30 minutes",
      "keyVocabulary": [],
      "opening": {
        "duration": 8,
        "activity": "",
        "materials": [],
        "visualSupports": ""
      },
      "main": {
        "duration": 27,
        "activity": "",
        "materials": [],
        "visualSupports": "",
        "decisionPoints": [
          "Decision Point 1: Observer la participation au cercle de partage, si un élève semble hésitant alors l'encourager en partageant d'abord sa propre tradition familiale simple",
          "Decision Point 2: Observer les réactions aux différentes traditions familiales, si des commentaires négatifs alors rediriger vers la beauté de la diversité dans notre communauté",
          "Decision Point 3: Observer l'engagement avec les images de traditions, si l'attention diminue alors inviter les élèves à pointer quelque chose qui leur rappelle leur propre famille"
        ]
      },
      "closing": {
        "duration": 10,
        "activity": "",
        "materials": [],
        "visualSupports": ""
      },
      "troubleshooting": {
        "ifStrugglingWith": "",
        "then": ""
      },
      "realWorldConnection": "",
      "differentiation": {
        "forStruggling": [
          "Utiliser des photos de familles de la classe en hiver pour personnaliser",
          "Commencer par partager une tradition familiale très simple (comme un repas spécial)",
          "Permettre de dessiner plutôt que d'écrire ses traditions",
          "Utiliser des supports visuels avec gestes pour expliquer 'tradition'"
        ],
        "forAdvanced": [
          "Aider à interviewer d'autres adultes de l'école sur leurs traditions hivernales",
          "Créer un livre illustré sur les différentes façons de célébrer l'hiver",
          "Faire des liens entre traditions familiales et géographie",
          "Proposer des explications aux plus jeunes sur la diversité des traditions"
        ],
        "forELL": [
          "Honorer les traditions de leur pays d'origine même si différentes des traditions d'hiver",
          "Permettre l'usage de mots de leur langue maternelle pour nommer leurs traditions",
          "Utiliser des cartes du monde pour situer leurs traditions familiales",
          "Encourager le partage de photos ou objets de leur culture d'origine"
        ],
        "forIEP": [
          "Respecter si l'élève préfère écouter plutôt que partager ses traditions familiales",
          "Adapter les matériaux d'affichage selon les besoins sensoriels",
          "Permettre différentes façons d'exprimer ses traditions (dessin, geste, aide d'un ami)",
          "Respecter les différences individuelles dans la participation aux discussions"
        ]
      },
      "assessmentCriteria": {
        "observable": [
          {
            "formative": [
              "Observation de la participation au cercle de partage",
              "Qualité de l'écoute pendant les partages d'autrui",
              "Créativité et engagement dans l'affiche collective"
            ],
            "summative": "Portfolio: Photo de l'affiche collective avec notes d'observation sur la participation",
            "self_assessment": "Pictogramme sourire pour 'J'ai partagé quelque chose de spécial de ma famille'"
          }
        ],
        "checkpoints": []
      },
      "emergencyBackup": {
        "techFails": "Si vidéos indisponibles, raconter histoires avec images",
        "materialsMissing": "Si cartes manquantes, dessiner plans simples au tableau",
        "studentsOverwhelmed": "Si concepts complexes, focus sur expérience personnelle",
        "timeShort": "Partage rapide d'une découverte importante"
      }
    },
    {
      "lessonNumber": 2,
      "lessonType": "core",
      "title": "Noël autour du monde",
      "progression": "Construit sur la leçon 1 en explorant comment différentes familles dans le monde célèbrent et créent des traditions d'hiver",
      "oneGoal": "",
      "duration": "30 minutes",
      "keyVocabulary": [],
      "opening": {
        "duration": 8,
        "activity": "",
        "materials": [],
        "visualSupports": ""
      },
      "main": {
        "duration": 27,
        "activity": "",
        "materials": [],
        "visualSupports": "",
        "decisionPoints": [
          "Decision Point 1: Observer les réactions aux traditions de Noël des différents pays, si certains élèves semblent exclus alors emphasiser que toutes les familles ont des façons spéciales de célébrer",
          "Decision Point 2: Observer la participation aux activités créatives, si un élève refuse de participer alors proposer un rôle d'observateur respecté ou une alternative culturellement appropriée",
          "Decision Point 3: Observer l'écoute lors des chants multiculturels, si l'attention se disperse alors engager par des gestes simples ou en demandant d'identifier des mots qu'ils reconnaissent"
        ]
      },
      "closing": {
        "duration": 10,
        "activity": "",
        "materials": [],
        "visualSupports": ""
      },
      "troubleshooting": {
        "ifStrugglingWith": "",
        "then": ""
      },
      "realWorldConnection": "",
      "differentiation": {
        "forStruggling": [
          "Utiliser des images simples pour montrer Noël dans différents pays",
          "Se concentrer sur une seule tradition de Noël (comme les lumières)",
          "Permettre d'identifier les pays sur un globe plutôt que de nommer",
          "Utiliser des chansons simples de Noël de différents pays avec gestes"
        ],
        "forAdvanced": [
          "Comparer les dates de Noël dans différents calendriers",
          "Expliquer pourquoi certaines familles ne célèbrent pas Noël",
          "Créer une présentation sur les Noëls du monde avec des faits intéressants",
          "Organiser une station d'apprentissage sur la géographie de Noël"
        ],
        "forELL": [
          "Partager comment Noël est célébré dans leur culture d'origine (si applicable)",
          "Utiliser leur langue maternelle pour nommer les traditions de Noël qu'ils connaissent",
          "Apprendre des mots de Noël en français avec support visuel",
          "Respecter si leur famille ne célèbre pas Noël"
        ],
        "forIEP": [
          "Adapter les décorations selon les sensibilités sensorielles",
          "Offrir un rôle d'observateur respecté si préféré",
          "Utiliser des supports de communication individualisés pour le vocabulaire de Noël",
          "Respecter les différences religieuses et culturelles individuelles"
        ]
      },
      "assessmentCriteria": {
        "observable": [
          {
            "formative": [
              "Participation lors de la présentation des pays",
              "Créativité et effort dans les décorations",
              "Tentative de chanter dans différentes langues"
            ],
            "summative": "Grille d'observation: identification des éléments de différentes traditions de Noël",
            "self_assessment": "Choix de l'autocollant pays préféré découvert aujourd'hui"
          }
        ],
        "checkpoints": []
      },
