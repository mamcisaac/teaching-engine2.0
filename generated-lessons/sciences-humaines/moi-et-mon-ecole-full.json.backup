    {
      "lessonNumber": 1,
      "lessonType": "core",
      "title": "Bienvenue dans notre école!",
      "progression": "Leçon de base: Introduction à l'école comme première communauté d'apprentissage hors de la famille",
      "oneGoal": "Students will identify their school as a special place and express feelings about being part of the school community",
      "duration": 45,
      "keyVocabulary": [
        "école",
        "élève",
        "bienvenue"
      ],
      "opening": {
        "duration": 8,
        "activity": "Welcome circle with school mascot or special object. Share excitement about being at school together.",
        "materials": [
          "school mascot or special school symbol",
          "welcome chart",
          "feeling faces cards"
        ],
        "visualSupports": "Big smile gestures, welcoming arms, photos of happy children at school",
        "decisionPoints": [
          "Decision Point 1: If students show nervousness about school, provide extra comfort and reassurance; if confident, encourage them to help welcome newer students",
          "Decision Point 2: If students come from different educational backgrounds, acknowledge diverse school experiences; if all local, explore what makes this school unique",
          "Decision Point 3: If students struggle with French vocabulary, use more gestures and visuals; if comfortable, encourage them to share school words from home languages"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Walk around classroom like we're exploring our school - look left, right, up at ceiling, point to favorite spots (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Act like helpful school community members - carry books carefully, hold doors open, wave hello to friends (30 seconds)",
            "duration": 30
          }
        ]
      },
      "main": {
        "duration": 27,
        "activity": "School building appreciation walk. Stop at special places to notice what makes school feel welcoming. Return to create a 'Our School is Special' chart with drawings and words.",
        "materials": [
          "clipboards for outdoor writing",
          "colored pencils",
          "chart paper",
          "camera for documentation"
        ],
        "visualSupports": "Point to building features, use appreciation gestures, encouraging facial expressions",
        "decisionPoints": [
          "Decision Point 1: Observer la familiarité des élèves avec le bâtiment de l'école, si limitée alors prendre plus de temps pour explorer et orienter les élèves",
          "Decision Point 2: Observer le niveau de soutien émotionnel nécessaire, si élevé alors utiliser le système de partenaire et rassurances supplémentaires sur la sécurité scolaire",
          "Decision Point 3: Observer les signes de nervosité ou d'incertitude, si présents alors se concentrer sur les personnes et espaces sécuritaires et accueillants"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Walk around classroom like we're exploring our school - look left, right, up at ceiling, point to favorite spots (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Act like helpful school community members - carry books carefully, hold doors open, wave hello to friends (30 seconds)",
            "duration": 30
          }
        ]
      },
      "closing": {
        "duration": 10,
        "activity": "Share one thing that makes our school special. Create class commitment to taking care of our special school.",
        "materials": {
          "required": [
            {
              "item": "Sharing circle space",
              "quantity": "Floor area for 25 students to sit in circle",
              "preparation": "Clear space, perhaps use carpet or tape marks for seating",
              "alternatives": [
                "Students at desks in circle",
                "Standing circle",
                "Small groups sharing"
              ]
            },
            {
              "item": "Commitment chart materials",
              "quantity": "Chart paper and markers for creating class commitment",
              "preparation": "Title 'We Take Care of Our School' ready to write",
              "alternatives": [
                "Whiteboard space",
                "Individual commitment cards",
                "Verbal commitments only"
              ]
            }
          ],
          "cultural_artifacts": [
            {
              "item": "School history artifacts",
              "quantity": "2-3 items showing school's past: old photos, yearbook, founding information",
              "preparation": "Contact office for historical materials, prepare simple story",
              "purpose": "Connect students to school's longer history and community roots"
            }
          ]
        },
        "visualSupports": "",
        "decisionPoints": [
          "Decision Point 1: If students enthusiastically share school appreciation, extend discussion to include community connections; if hesitant, focus on simple positive observations",
          "Decision Point 2: If students identify diverse school features, celebrate variety and inclusion; if focused on similar aspects, gently introduce different perspectives",
          "Decision Point 3: If commitment creation goes quickly, add personal school care goals; if challenging, keep commitments simple and concrete"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Walk around classroom like we're exploring our school - look left, right, up at ceiling, point to favorite spots (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Act like helpful school community members - carry books carefully, hold doors open, wave hello to friends (30 seconds)",
            "duration": 30
          }
        ]
      },
      "troubleshooting": {
        "ifStrugglingWith": "Students feeling nervous or uncertain about school",
        "then": "Focus on safe, welcoming people and spaces. Use more reassurance and buddy support"
      },
      "realWorldConnection": "Every person belongs to communities like school, family, and neighborhood",
      "differentiation": {
        "forStruggling": [
          "Use concrete school examples with photos",
          "Point to specific welcoming features during walk",
          "Draw simple pictures instead of writing on chart",
          "Pair with confident buddy for school exploration"
        ],
        "forAdvanced": [
          "Lead discussions about what makes spaces welcoming",
          "Create detailed drawings of special school features",
          "Interview staff about school building history",
          "Suggest improvements for school welcome areas"
        ],
        "forELL": [
          "Connect school feelings to home country experiences",
          "Learn 'welcome' words in multiple languages",
          "Use gesture and visual cues for building appreciation",
          "Create bilingual labels for special school spaces"
        ],
        "forIEP": [
          "Focus on sensory aspects of welcoming spaces",
          "Adapt building walk for individual mobility needs",
          "Use alternative communication to express school feelings",
          "Provide quiet space if overwhelmed by school tour"
        ]
      },
      "assessmentCriteria": {
        "observable": [
          "Student expresses positive feelings about school",
          "Student points to or names things that make school special",
          "Student participates in creating 'Our School is Special' chart",
          "Student shows pride when discussing their school"
        ],
        "checkpoints": [
          "During walk: Student notices welcoming features",
          "Chart creation: Student contributes ideas about school specialness",
          "Closing circle: Student shares what makes school special",
          "Ongoing: Student demonstrates comfort in school environment"
        ]
      },
      "emergencyBackup": {
        "techFails": "Si vidéos indisponibles, raconter histoires avec images",
