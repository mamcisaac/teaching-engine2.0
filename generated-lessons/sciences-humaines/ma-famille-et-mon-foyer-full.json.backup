      "lessonNumber": 1,
      "lessonType": "core",
      "title": "Qu'est-ce qu'une famille?",
      "progression": "Leçon de base: Introduction au concept de famille comme première communauté d'appartenance",
      "oneGoal": "Students will understand that families come in many different forms and all families are special and important",
      "duration": 45,
      "keyVocabulary": [
        "famille",
        "différent",
        "spécial"
      ],
      "opening": {
        "duration": 8,
        "activity": "Family circle where students share one special thing about their family without naming specific members. Introduce the word 'famille' with warm, inclusive gestures.",
        "materials": [
          "family photos from diverse sources",
          "heart-shaped cards",
          "welcoming music"
        ],
        "visualSupports": "Open arms for inclusion, heart gestures for love, smiling faces for celebration",
        "decisionPoints": [
          "Decision Point 1: If students confidently share family positives, celebrate all contributions; if hesitant about family differences, emphasize that all family types are valued and special",
          "Decision Point 2: If students use judgmental language about families, gently redirect to appreciation; if inclusive language, reinforce positive attitudes toward family diversity",
          "Decision Point 3: If students want to share personal details, allow brief sharing; if private about family, respect privacy and use general appreciation approach"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Act out family activities - cooking motions, cleaning house, hugging family members gently (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show different ways to help at home - set table, put toys away, feed pets with care (30 seconds)",
            "duration": 30
          }
        ]
      },
      "main": {
        "duration": 27,
        "activity": "Family diversity exploration using picture books and photos showing different family structures. Students create a 'Families are Special' gallery wall, adding drawings or words about what makes families special. Emphasize that ALL families are wonderful.",
        "materials": [
          "diverse family books",
          "family structure photos",
          "gallery wall space",
          "art supplies"
        ],
        "visualSupports": "Pointing to different family types with equal celebration, diversity hand gestures, appreciation expressions",
        "decisionPoints": [
          "Decision Point 1: Observer le niveau de confort des élèves lors du partage sur leur structure familiale, si certains semblent hésitants alors maintenir les discussions générales et utiliser des exemples de livres",
          "Decision Point 2: Observer le besoin de soutien émotionnel lors des discussions familiales, si des émotions intenses alors offrir des reassurances supplémentaires et valider tous les sentiments",
          "Decision Point 3: Observer les réactions à la diversité des familles, si des jugements négatifs alors réemphasiser que toutes les différences sont merveilleuses et célébrées"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Act out family activities - cooking motions, cleaning house, hugging family members gently (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show different ways to help at home - set table, put toys away, feed pets with care (30 seconds)",
            "duration": 30
          }
        ]
      },
      "closing": {
        "duration": 10,
        "activity": "Family appreciation circle where students share one word that describes how families make them feel. End with group chant: 'Toutes les familles sont spéciales!'",
        "materials": [],
        "visualSupports": "",
        "decisionPoints": [
          "Decision Point 1: If students express genuine family appreciation, encourage specific gratitude examples; if struggling to find positives, provide gentle prompting about family care",
          "Decision Point 2: If group chant flows enthusiastically, repeat and add actions; if awkward or reluctant, make participation optional and focus on individual reflection",
          "Decision Point 3: If students show pride in family differences, celebrate diverse family strengths; if defensive about uniqueness, reassure that different families bring special gifts"
        ],
        "movementBreaks": [
          {
            "time": "9 minutes",
            "activity": "Act out family activities - cooking motions, cleaning house, hugging family members gently (45 seconds)",
            "duration": 45
          },
          {
            "time": "18 minutes",
            "activity": "Show different ways to help at home - set table, put toys away, feed pets with care (30 seconds)",
            "duration": 30
          }
        ]
      },
      "troubleshooting": {
        "ifStrugglingWith": "Students feeling that their family is different or unusual",
        "then": "Emphasize that different is wonderful and provide extra examples of their family type being celebrated"
