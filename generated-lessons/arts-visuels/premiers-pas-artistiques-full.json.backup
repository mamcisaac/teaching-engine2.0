    {
      "lessonNumber": 1,
      "lessonType": "core",
      "title": "Bonjour l'art!",
      "oneGoal": "Students will recognize art exists everywhere around them",
      "duration": 45,
      "keyVocabulary": [
        "art",
        "voir",
        "couleur"
      ],
      "opening": {
        "duration": "~8 min",
        "activity": "Circle time greeting with art objects. Show 3-4 familiar items (crayon, picture book, decorated pencil case). Point and say 'Voici l'art!' Use big gestures and excited voice. Students repeat with actions.",
        "materials": [
          "Art objects for demonstration",
          "Visual routine chart",
          "Basic art supplies (crayons, paper, glue)"
        ],
        "visualSupports": "Gesture cards for 'voir' (hand above eyes), visual routine chart for circle time",
        "decisionPoints": [
          "Si les élèves sont nerveux au début → commencer par montrer comment tenir les objets artistiques et les toucher doucement",
          "Si certains élèves ne participent pas → les inviter à pointer vers l'art avec l'enseignant en disant ensemble 'Voici!'",
          "Si les gestes sont trop excités → modéliser des mouvements plus calmes et inviter à copier"
        ],
        "movementBreaks": [
          "Big gestures and excited movements for 'Voici l'art!', action-based vocabulary repetition"
        ]
      },
      "main": {
        "duration": "~27 min",
        "activity": "Art Hunt Around the School: Students walk in pairs with collection baskets, looking for 'art' examples everywhere - posters, decorations, patterns, colors. Teacher guides: 'Regardez! Voici de l'art!' Students collect or sketch 3 things they find beautiful. Return to class and sort finds by colors: 'Rouge ici, bleu là!' Practice vocabulary through discovery and sorting activities.",
        "materials": [
          "Color word cards with pictures",
          "Small collection basket per student (20-25 total)",
          "Clipboard for recording finds (optional)",
          "Chart paper for color sorting",
          "Marker for labeling"
        ],
        "visualSupports": "Color cards with French words and pictures, visual vocabulary chart showing 'art/voir/couleur' with images and gestures",
        "decisionPoints": [
          "Si les élèves trouvent beaucoup d'exemples rapidement: Extended art hunt to playground or library",
          "Si les élèves ont de la difficulté à identifier l'art: Focus on obvious examples like classroom posters and student work",
          "Si le temps permet: Create a class 'art map' showing all the places where art was discovered"
        ],
        "movementBreaks": [
          "Walking art hunt provides natural movement",
          "Color sorting with standing and moving around chart"
        ]
      },
      "closing": {
        "duration": "~10 min",
        "activity": "Art Gallery Share. Students place their chosen art object on desk. Walk around like in an art gallery, whispering 'Je vois...' and naming colors they see. End with group cheer: 'L'art est partout!' (Art is everywhere!)",
        "materials": [
          "Art objects for demonstration",
          "Visual routine chart",
          "Basic art supplies (crayons, paper, glue)"
        ],
        "visualSupports": "Gallery walk behavior chart, whisper voice visual cue, celebration gesture poster",
        "decisionPoints": [
          "Si les élèves sont nerveux au début → commencer par montrer comment tenir les objets artistiques et les toucher doucement",
          "Si certains élèves ne participent pas → les inviter à pointer vers l'art avec l'enseignant en disant ensemble 'Voici!'",
          "Si les gestes sont trop excités → modéliser des mouvements plus calmes et inviter à copier"
        ],
        "movementBreaks": [
          "Gallery walk movement, celebration gestures for 'L'art est partout!'"
        ]
      },
      "troubleshooting": {
        "ifStrugglingWith": "Students having difficulty identifying what counts as 'art' in their environment",
        "then": "Picture book art hunt: Use any picture book, point to illustrations saying 'Voici l'art!' Students find colors and repeat vocabulary. Works with any adult, no French required."
      },
      "realWorldConnection": "Looking for art in their bedroom, kitchen, playground - send home simple visual checklist with pictures",
      "differentiation": {
        "pourDifficultés": [
          "Provide visual examples and demonstrations",
          "Use simple gestures and basic vocabulary",
          "Allow non-verbal responses initially",
          "Partner with supportive peer"
        ],
        "pourAvancés": [
          "Encourage detailed French descriptions",
          "Challenge with complex art concepts",
          "Lead activities and help others",
          "Explore creative extensions"
        ],
        "pourLangue": [
          "Provide visual vocabulary supports",
          "Allow L1 support when needed",
          "Use gestures and pointing",
          "Focus on concrete, visible concepts"
        ],
        "pourPEI": [
          "Adapt materials and tools as needed",
          "Provide sensory accommodations",
          "Adjust expectations and timing",
          "Offer multiple ways to show understanding"
        ]
      },
      "assessmentCriteria": {
        "observable": [
          "L'élève explore les matériaux artistiques avec curiosité",
          "L'élève explique ses choix artistiques en français simple",
          "L'élève respecte les matériaux et l'espace de travail",
          "L'élève apprécie les créations artistiques des autres"
        ],
        "checkpoints": [
          "Utilise les techniques artistiques démontrées",
          "Exprime ses idées par l'art visuel",
          "Utilise le vocabulaire artistique approprié",
          "Montre fierté dans ses créations artistiques"
        ]
      }
