        "movementBreaks": [
          "Physical actions for each vocabulary word, looking gestures around the room"
        ]
      },
      "main": {
        "duration": "~27 min",
        "activity": "Detective Eyes Investigation: Students become art detectives using magnifying glasses to examine classroom objects closely. Practice 'Je regarde les détails!' while finding shapes, textures, patterns. Create detail drawings of one special object, focusing on shapes they discover. Share findings: 'J'ai trouvé un cercle!' Use shape vocabulary while examining and drawing.",
        "materials": [
          "Magnifying glasses or cardboard cutouts (20-25 total)",
          "Shape cards (circle, square, triangle)",
          "Paper and crayons for detail drawings",
          "Clipboards for drawing support",
          "Collection of interesting textured objects"
        ],
        "visualSupports": "Shape reference chart with French words, detective investigation steps poster, magnifying glass technique visual",
        "decisionPoints": [
          "Si les élèves finissent rapidement: Challenge to find shapes in more complex objects or patterns",
          "Si les élèves ont besoin de plus de temps: Focus on one simple object for detailed examination"
        ],
        "movementBreaks": [
          "Walking around room as detectives",
          "Standing and moving to examine different objects"
        ]
      },
      "closing": {
        "duration": "~10 min",
        "activity": "Detail Gallery Walk. Post drawings on board. Students walk by and point to details they can identify, saying 'Je vois un détail!' or 'Une forme!' End with group celebration of their detective eyes.",
        "materials": [
          "Art objects for demonstration",
          "Visual routine chart",
          "Basic art supplies (crayons, paper, glue)"
        ],
        "visualSupports": "Gallery walk behavior chart, sentence starters for sharing observations",
        "decisionPoints": [
          "Si les élèves sont nerveux au début → commencer par montrer comment tenir les objets artistiques et les toucher doucement",
          "Si certains élèves ne participent pas → les inviter à pointer vers l'art avec l'enseignant en disant ensemble 'Voici!'",
          "Si les gestes sont trop excités → modéliser des mouvements plus calmes et inviter à copier"
        ],
        "movementBreaks": [
          "Gallery walk movement, celebration gestures for detective success"
        ]
      },
      "troubleshooting": {
        "ifStrugglingWith": "Students having difficulty seeing or identifying small details in objects",
        "then": "Shape puppet show: Use any geometric shapes (blocks, cut paper). Make shapes 'talk' to each other in simple French. Students identify and respond to shapes. No art background needed."
      },
      "realWorldConnection": "Noticing shapes in clouds, patterns on clothing, textures on playground - encourage 'detective eyes' at home and recess",
