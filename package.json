{
  "name": "teaching-engine-2.0",
  "version": "2.0.0",
  "private": true,
  "description": "A comprehensive digital teaching assistant for Grade 1 French Immersion teachers in PEI",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "echo 'Please use: cd server && npm run dev & cd client && npm run dev'",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:strict": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @teaching-engine/database db:generate",
    "check:docs": "echo 'Docs check placeholder'",
    "test:e2e": "node tests/e2e/run-assessment-tests.js quick",
    "test:e2e:full": "node tests/e2e/run-assessment-tests.js full",
    "test:e2e:agents": "node tests/e2e/run-assessment-tests.js agents",
    "test:e2e:stress": "node tests/e2e/run-assessment-tests.js stress --parallel",
    "test:e2e:headless": "HEADLESS=true jest --config=tests/e2e/jest.config.js tests/e2e/quick-demo.test.js",
    "test:e2e:all": "jest --config=tests/e2e/jest.config.js",
    "test:e2e:smoke": "jest --config=tests/e2e/jest.config.js tests/e2e/complete-ui-test.js",
    "test:e2e:ci": "HEADLESS=true node tests/e2e/run-assessment-tests.js full --headless --parallel",
    "test:assessment": "node tests/e2e/run-assessment-tests.js full --headless",
    "test:assessment:visual": "node tests/e2e/run-assessment-tests.js full"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@types/puppeteer": "^7.0.4",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "puppeteer": "^24.17.0"
  }
}