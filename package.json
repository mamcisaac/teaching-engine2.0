{
  "name": "curriculum-planner",
  "packageManager": "pnpm@10.11.1",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "scripts",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "dev:legacy": "pnpm db:generate && concurrently -k --success first \"pnpm --filter server run dev\" \"pnpm --filter client run dev\"",
    "dev:clean": "node scripts/cleanup-dev.js",
    "dev:logs": "tail -f *.log",
    "dev:ports": "lsof -i :3000,5173,5555,9229",
    "dev:reset": "pnpm dev:clean && pnpm db:push --force-reset && pnpm db:seed",
    "build": "pnpm db:generate && pnpm -r build",
    "test": "node scripts/smart-test-runner-enhanced.js",
    "test:watch": "node scripts/smart-test-runner-enhanced.js watch",
    "test:coverage": "node scripts/smart-test-runner-enhanced.js coverage",
    "test:debug": "node scripts/smart-test-runner-enhanced.js debug",
    "test:quick": "node scripts/smart-test-runner-enhanced.js quick",
    "test:fix": "node scripts/smart-test-runner-enhanced.js fix",
    "test:ci": "node scripts/smart-test-runner-enhanced.js all --coverage",
    "test:help": "node scripts/smart-test-runner-enhanced.js help",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ci": "playwright test --config=playwright.config.ci.ts --reporter=github",
    "test:e2e:smoke": "playwright test tests/e2e/smoke-simple.spec.ts",
    "test:e2e:full": "playwright test --config=playwright.config.full.ts",
    "test:performance": "cd tests/performance && node scripts/run-performance-suite.js",
    "test:performance:quick": "cd tests/performance && artillery quick --count 10 --num 3 http://localhost:3000/api/health",
    "test:performance:monitor": "cd tests/performance && node scripts/run-performance-suite.js --monitor",
    "test:visual": "cd tests/visual && npx playwright test --config=playwright-visual.config.ts",
    "test:visual:update": "cd tests/visual && npx playwright test --update-snapshots --config=playwright-visual.config.ts",
    "test:visual:ui": "cd tests/visual && npx playwright test --ui --config=playwright-visual.config.ts",
    "test:accessibility": "cd tests/visual && npx playwright test --grep \"Accessibility\" --config=playwright-visual.config.ts",
    "test:nonfunction": "concurrently \"pnpm test:performance\" \"pnpm test:visual\"",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:nonfunction",
    "lint": "eslint --config .eslintrc.json \"**/*.{ts,tsx,js,jsx}\"",
    "lint:strict": "eslint --config .eslintrc.strict.json \"**/*.{ts,tsx}\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\"",
    "lint:strict:fix": "eslint --config .eslintrc.strict.json \"**/*.{ts,tsx}\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --fix",
    "typecheck": "pnpm --filter client run typecheck && pnpm --filter server run typecheck",
    "prepare": "husky install",
    "db:generate": "pnpm --filter @teaching-engine/database db:generate",
    "db:migrate": "pnpm --filter @teaching-engine/database db:migrate",
    "db:push": "pnpm --filter @teaching-engine/database db:push",
    "db:deploy": "pnpm --filter @teaching-engine/database db:deploy",
    "db:studio": "pnpm --filter @teaching-engine/database db:studio",
    "db:seed": "pnpm --filter @teaching-engine/database db:seed",
    "db:seed:test": "NODE_OPTIONS='--import tsx' NODE_ENV=test node scripts/seed.ts",
    "postinstall": "pnpm --filter @teaching-engine/database db:generate",
    "setup:e2e:db": "tsx scripts/setup-e2e-db.ts",
    "check:docs": "pnpm --filter scripts run verify-docs",
    "analyze:bundle": "source-map-explorer 'client/dist/assets/index-*.js' --no-border-checks --html client/dist/bundle-report.html",
    "cleanup:legacy": "node scripts/cleanup-legacy-code.js",
    "cleanup:legacy:dry": "node scripts/cleanup-legacy-code.js --dry-run",
    "test:categorize": "node scripts/test-categorizer.js",
    "test:categorize:organize": "node scripts/test-categorizer.js --organize",
    "monitoring:start": "cd tests/performance/monitoring/docker && docker-compose up -d",
    "monitoring:stop": "cd tests/performance/monitoring/docker && docker-compose down",
    "monitoring:logs": "cd tests/performance/monitoring/docker && docker-compose logs -f",
    "monitoring:restart": "pnpm monitoring:stop && pnpm monitoring:start",
    "perf:baseline:update": "cd tests/performance && cp results/latest-results.json baseline-metrics.json",
    "perf:report": "cd tests/performance && node scripts/generate-performance-report.js",
    "visual:baseline:update": "pnpm test:visual:update && git add tests/visual/test-results/",
    "ci:performance": "NODE_ENV=test pnpm test:performance",
    "ci:visual": "NODE_ENV=test pnpm test:visual",
    "ci:nonfunction": "NODE_ENV=test pnpm test:nonfunction",
    "test:contract": "concurrently \"pnpm --filter client test:pact\" \"pnpm --filter server test:pact:verify\"",
    "test:contract:consumer": "pnpm --filter client test:pact",
    "test:contract:provider": "pnpm --filter server test:pact:verify",
    "test:contract:publish": "pnpm --filter client test:pact:publish && pnpm --filter server test:pact:publish",
    "pact:broker:start": "docker-compose -f docker-compose.pact.yml up -d",
    "pact:broker:stop": "docker-compose -f docker-compose.pact.yml down",
    "pact:broker:logs": "docker-compose -f docker-compose.pact.yml logs -f pact-broker",
    "pact:can-i-deploy": "npx @pact-foundation/pact-cli can-i-deploy --pacticipant TeachingEngineClient --latest --pacticipant TeachingEngineServer --latest --broker-base-url ${PACT_BROKER_URL:-http://localhost:9292} --broker-username ${PACT_BROKER_USERNAME:-admin} --broker-password ${PACT_BROKER_PASSWORD:-admin}",
    "pact": "node scripts/run-pact-tests.js",
    "test:mutation": "node scripts/mutation-test-runner.cjs",
    "test:mutation:server": "node scripts/mutation-test-runner.cjs --target server",
    "test:mutation:client": "node scripts/mutation-test-runner.cjs --target client",
    "test:mutation:core": "node scripts/mutation-test-runner.cjs --scope core",
    "test:mutation:ci": "node scripts/mutation-test-runner.cjs --ci",
    "test:mutation:parallel": "node scripts/mutation-test-runner.cjs --parallel",
    "test:mutation:report": "node scripts/mutation-test-runner.cjs --reporters html,clear-text,progress"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.53.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "pdf-parse": "^1.1.1",
    "prettier": "^3.6.1",
    "puppeteer": "^24.10.2",
    "source-map-explorer": "^2.5.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --config .eslintrc.strict.json --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/server-puppeteer": "^2025.5.12",
    "@types/bcryptjs": "^3.0.0",
    "@types/multer": "^1.4.13",
    "@upstash/context7-mcp": "^1.0.14",
    "bcryptjs": "^3.0.2",
    "date-fns": "^2.30.0",
    "franc": "^6.2.0",
    "luxon": "^3.6.1",
    "multer": "^2.0.1"
  }
}
