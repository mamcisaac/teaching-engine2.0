{
  "name": "teaching-engine-2.0",
  "version": "2.0.0",
  "private": true,
  "description": "A comprehensive digital teaching assistant for Grade 1 French Immersion teachers in PEI",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "echo 'Please use: cd server && npm run dev & cd client && npm run dev'",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "jest --config=tests/e2e/jest.config.js tests/e2e/quick-demo.test.js",
    "test:e2e:full": "jest --config=tests/e2e/jest.config.js tests/e2e/emily-assessment-workflows.test.js",
    "test:e2e:headless": "HEADLESS=true jest --config=tests/e2e/jest.config.js tests/e2e/quick-demo.test.js",
    "test:e2e:all": "jest --config=tests/e2e/jest.config.js",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@types/puppeteer": "^7.0.4",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "puppeteer": "^24.17.0"
  }
}