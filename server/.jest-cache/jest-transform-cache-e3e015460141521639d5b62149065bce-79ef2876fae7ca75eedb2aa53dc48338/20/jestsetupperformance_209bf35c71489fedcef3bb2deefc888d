// Fast mock model factory
function createMockModel(modelName) {
  const mockData = new Map();
  let idCounter = 0;
  
  return {
    create: jest.fn().mockImplementation(({ data }) => {
      const id = data.id || `${modelName}-${++idCounter}`;
      const record = { id, ...data };
      mockData.set(id, record);
      return Promise.resolve(record);
    }),
    findMany: jest.fn().mockResolvedValue([]),
    findFirst: jest.fn().mockResolvedValue(null),
    findUnique: jest.fn().mockImplementation(({ where }) => {
      const id = where?.id;
      return Promise.resolve(mockData.get(id) || null);
    }),
    update: jest.fn().mockImplementation(({ where, data }) => {
      const id = where?.id;
      const existing = mockData.get(id);
      if (existing) {
        const updated = { ...existing, ...data };
        mockData.set(id, updated);
        return Promise.resolve(updated);
      }
      return Promise.resolve(null);
    }),
    delete: jest.fn().mockImplementation(({ where }) => {
      const id = where?.id;
      const deleted = mockData.get(id);
      mockData.delete(id);
      return Promise.resolve(deleted);
    }),
    deleteMany: jest.fn().mockImplementation(() => {
      const count = mockData.size;
      mockData.clear();
      return Promise.resolve({ count });
    }),
    count: jest.fn().mockImplementation(() => Promise.resolve(mockData.size)),
    upsert: jest.fn(),
    aggregate: jest.fn().mockResolvedValue(null),
    groupBy: jest.fn().mockResolvedValue([]),
  };
}

