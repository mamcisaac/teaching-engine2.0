import { describe, it, expect } from '@jest/globals';
import request from 'supertest';
import jwt from 'jsonwebtoken';
describe('Minimal JWT Debug', () => {
    it('should decode what token is generated', async () => {
        // Import app after env is set
        const { app } = await import('../../src/index');
        const uniqueEmail = `minimal-${Date.now()}@example.com`;
        // Register
        const res = await request(app)
            .post('/api/auth/register')
            .send({
            email: uniqueEmail,
            password: 'SecureTestPassword123!',
            name: 'Test User'
        });
        console.log('\n=== REGISTRATION RESPONSE ===');
        console.log('Status:', res.status);
        console.log('Body keys:', Object.keys(res.body));
        console.log('Has accessToken?', 'accessToken' in res.body);
        console.log('Has token?', 'token' in res.body);
        if (res.body.accessToken) {
            console.log('\n=== TOKEN ANALYSIS ===');
            const token = res.body.accessToken;
            console.log('Token length:', token.length);
            console.log('Token parts:', token.split('.').length);
            // Decode without verification
            const decoded = jwt.decode(token);
            console.log('Decoded token:', JSON.stringify(decoded, null, 2));
            // Try to verify with test secret
            try {
                const verified = jwt.verify(token, 'test-secret-key');
                console.log('Token verified successfully with test-secret-key');
                console.log('Verified payload:', JSON.stringify(verified, null, 2));
            }
            catch (err) {
                console.log('Token verification failed:', err.message);
            }
        }
        expect(res.status).toBe(201);
        // Now test the /me endpoint
        if (res.body.accessToken) {
            console.log('\n=== TESTING /api/auth/me ===');
            const meRes = await request(app)
                .get('/api/auth/me')
                .set('Authorization', `Bearer ${res.body.accessToken}`);
            console.log('Me response status:', meRes.status);
            console.log('Me response body:', JSON.stringify(meRes.body, null, 2));
        }
    });
});
