describe('Error Handling and Edge Cases', () => {
    let connector;
    beforeEach(() => {
        connector = new TestConnector();
    });
    describe('malformed data handling', () => {
        it('should handle null and undefined inputs gracefully', () => {
            expect(connector['parseDuration'](null)).toBeNull();
            expect(connector['parseDuration'](undefined)).toBeNull();
            expect(connector['parseGradeRange'](null)).toEqual({ min: 1, max: 1 });
            expect(connector['parseGradeRange'](undefined)).toEqual({ min: 1, max: 1 });
            expect(connector['normalizeSubject'](null)).toBe('null');
            expect(connector['normalizeSubject'](undefined)).toBe('undefined');
            expect(connector['extractMaterials'](null)).toEqual([]);
            expect(connector['extractMaterials'](undefined)).toEqual([]);
        });
        it('should handle extremely long input gracefully', () => {
            const longString = 'x'.repeat(10000);
            expect(() => connector['parseDuration'](longString)).not.toThrow();
            expect(() => connector['parseGradeRange'](longString)).not.toThrow();
            expect(() => connector['normalizeSubject'](longString)).not.toThrow();
            expect(() => connector['extractMaterials'](longString)).not.toThrow();
        });
        it('should handle special characters and unicode', () => {
            const unicodeString = 'Mathématiques et Sciences 中文 🧪';
            expect(() => connector['normalizeSubject'](unicodeString)).not.toThrow();
            expect(() => connector['extractMaterials'](unicodeString)).not.toThrow();
        });
    });
    describe('network error simulation', () => {
        beforeEach(() => {
            jest.useFakeTimers();
        });
        afterEach(() => {
            jest.useRealTimers();
        });
        it('should handle DNS resolution failures', async () => {
            global.fetch.mockRejectedValue(new Error('getaddrinfo ENOTFOUND invalid-domain.com'));
            const delaySpy = jest.spyOn(connector, 'delay').mockResolvedValue(undefined);
            const result = await connector['fetchWithRetryAndTimeout']('https://invalid-domain.com');
            expect(result).toBeNull();
            expect(delaySpy).toHaveBeenCalled();
        });
        it('should handle connection timeouts', async () => {
            global.fetch.mockImplementation(() => new Promise((_, reject) => {
                setTimeout(() => reject(new Error('ECONNRESET')), 100);
            }));
            const result = await connector['fetchWithRetryAndTimeout']('https://slow-server.com', {}, 3, 50);
            expect(result).toBeNull();
        });
        it('should handle aborted requests', async () => {
            global.fetch.mockRejectedValue(Object.assign(new Error('The operation was aborted'), { name: 'AbortError' }));
            await expect(connector['fetchWithTimeout']('https://example.com', {}, 1000)).rejects.toThrow('The operation was aborted');
        });
    });
    describe('performance considerations', () => {
        it('should handle large material lists efficiently', () => {
            const longDescription = Array.from({ length: 1000 }, (_, i) => `material${i}`).join(', ');
            const startTime = Date.now();
            const materials = connector['extractMaterials'](`Materials: ${longDescription}`);
