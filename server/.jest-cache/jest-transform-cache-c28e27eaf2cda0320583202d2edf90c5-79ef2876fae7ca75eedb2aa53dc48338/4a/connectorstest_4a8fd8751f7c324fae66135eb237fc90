        it('should retry on failure', async () => {
            const mockErrorResponse = new Response('error', { status: 500, statusText: 'Internal Server Error' });
            const mockSuccessResponse = new Response('success', { status: 200 });
            mockSuccessResponse.text = jest.fn().mockResolvedValue('success content');
