/**
 * Security Mock Verification Tests
 * Ensures our security mocks are working correctly
 */
import { describe, it, expect, beforeEach } from '@jest/globals';
import { setupSecurityTestEnv, restoreOriginalEnv } from './test-env';
import { secureFetchMock } from '../mocks/fetch-secure.mock';
// Import OpenAI to test the secure mock
import OpenAI from 'openai';
describe('Security Mock Verification', () => {
    let originalEnv;
    beforeEach(() => {
        originalEnv = setupSecurityTestEnv();
        secureFetchMock.clearMockResponses();
        secureFetchMock.resetRateLimits();
    });
    afterEach(() => {
        restoreOriginalEnv(originalEnv);
    });
    describe('Environment Configuration', () => {
        it('should have security environment variables set', () => {
            expect(process.env.ENABLE_SECURITY_CHECKS).toBe('true');
            expect(process.env.VALIDATE_API_KEYS).toBe('true');
            expect(process.env.JWT_SECRET).toBe('test-jwt-secret-key');
            expect(process.env.OPENAI_API_KEY).toBe('test-openai-key');
        });
        it('should have rate limiting configuration', () => {
            expect(process.env.RATE_LIMIT_WINDOW).toBe('60000');
            expect(process.env.RATE_LIMIT_MAX_REQUESTS).toBe('10');
        });
    });
    describe('Secure Fetch Mock', () => {
        it('should block HTTP requests to external domains', async () => {
            const response = await secureFetchMock('http://external.com/api/data');
            expect(response.status).toBe(403);
            const error = await response.json();
            expect(error.error).toContain('Insecure HTTP protocol');
        });
        it('should allow HTTP for localhost', async () => {
            const response = await secureFetchMock('http://localhost:3000/api/health');
            expect(response.ok).toBe(true);
            expect(response.status).toBe(200);
        });
        it('should block malicious domains', async () => {
            const response = await secureFetchMock('https://malicious.com/api/steal');
            expect(response.status).toBe(403);
            const error = await response.json();
            expect(error.error).toContain('Blocked domain');
        });
        it('should validate required headers', async () => {
            const response = await secureFetchMock('https://api.example.com/data', {
                headers: {
                    // Missing user-agent
                    'content-type': 'application/json',
                },
            });
            expect(response.status).toBe(403);
            const error = await response.json();
            expect(error.error).toContain('Missing required header');
        });
        it('should enforce rate limits', async () => {
            // Make 10 requests (the limit)
            for (let i = 0; i < 10; i++) {
                const response = await secureFetchMock('https://api.example.com/data', {
                    headers: { 'user-agent': 'test-client' },
                });
                expect(response.ok).toBe(true);
            }
            // 11th request should be rate limited
            const response = await secureFetchMock('https://api.example.com/data', {
                headers: { 'user-agent': 'test-client' },
            });
            expect(response.status).toBe(429);
            const error = await response.json();
            expect(error.error).toContain('Rate limit exceeded');
        });
        it('should validate authorization header format', async () => {
            const response = await secureFetchMock('https://api.example.com/protected', {
                headers: {
                    'user-agent': 'test-client',
                    'authorization': 'InvalidFormat token123',
                },
            });
            expect(response.status).toBe(403);
            const error = await response.json();
            expect(error.error).toContain('Invalid authorization header format');
        });
    });
    describe('OpenAI Secure Mock', () => {
        it('should validate API key on initialization', () => {
            // Missing API key should throw
            expect(() => new OpenAI({ apiKey: '' })).toThrow('OpenAI API key is required');
        });
        it('should validate API key format for requests', async () => {
            const client = new OpenAI({ apiKey: 'invalid-key' });
            await expect(client.chat.completions.create({
                model: 'gpt-3.5-turbo',
                messages: [{ role: 'user', content: 'Hello' }],
            })).rejects.toThrow('Invalid API Key');
        });
        it('should accept valid API keys', async () => {
            const client = new OpenAI({ apiKey: 'test-api-key' });
            const response = await client.chat.completions.create({
                model: 'gpt-3.5-turbo',
                messages: [{ role: 'user', content: 'Hello' }],
            });
            expect(response.choices[0].message.content).toContain('Mock generated content');
        });
        it('should enforce rate limits on OpenAI calls', async () => {
            const client = new OpenAI({ apiKey: 'test-api-key' });
            // Make 10 requests quickly
            const promises = [];
            for (let i = 0; i < 10; i++) {
                promises.push(client.embeddings.create({
                    model: 'text-embedding-3-small',
                    input: 'Test text',
                }));
            }
            await Promise.all(promises);
            // 11th request should fail
            await expect(client.embeddings.create({
                model: 'text-embedding-3-small',
                input: 'Test text',
            })).rejects.toThrow('Rate limit exceeded');
        });
    });
    describe('Security Headers Validation', () => {
        it('should include security headers in fetch responses', async () => {
            const response = await secureFetchMock('https://api.example.com/data', {
                headers: { 'user-agent': 'test-client' },
            });
            expect(response.headers.get('strict-transport-security')).toBe('max-age=31536000; includeSubDomains');
            expect(response.headers.get('x-content-type-options')).toBe('nosniff');
            expect(response.headers.get('x-frame-options')).toBe('DENY');
            expect(response.headers.get('x-xss-protection')).toBe('1; mode=block');
        });
    });
});
