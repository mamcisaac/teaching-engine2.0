import { describe, it, expect } from '@jest/globals';
import request from 'supertest';
import { resetRateLimiterState } from '../../src/middleware/rateLimiter';
describe('Simple JWT Test', () => {
    it('should test registration and auth flow', async () => {
        // Reset rate limiter
        resetRateLimiterState();
        // Import app
        const { app } = await import('../../src/index');
        const uniqueEmail = `simple-jwt-${Date.now()}@example.com`;
        // Register
        const registerRes = await request(app)
            .post('/api/auth/register')
            .send({
            email: uniqueEmail,
            password: 'SecureTestPassword123!',
            name: 'Test User'
        });
        // Check registration
        if (registerRes.status !== 201) {
            throw new Error(`Registration failed: ${registerRes.status} - ${JSON.stringify(registerRes.body)}`);
        }
        // Get token
        const token = registerRes.body.accessToken;
        if (!token) {
            throw new Error(`No accessToken in response: ${JSON.stringify(registerRes.body)}`);
        }
        // Access protected route
        const meRes = await request(app)
            .get('/api/auth/me')
            .set('Authorization', `Bearer ${token}`);
        // Check me response
        if (meRes.status !== 200) {
            throw new Error(`/api/auth/me failed: ${meRes.status} - ${JSON.stringify(meRes.body)}`);
        }
        expect(meRes.status).toBe(200);
        expect(meRes.body.user.email).toBe(uniqueEmail);
    });
});
