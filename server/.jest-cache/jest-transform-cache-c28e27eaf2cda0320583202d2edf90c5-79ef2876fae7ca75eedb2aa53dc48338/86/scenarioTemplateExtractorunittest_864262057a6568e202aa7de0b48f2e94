    describe('Performance and Memory Tests', () => {
        it('should handle multiple simultaneous extractions efficiently', async () => {
            const start = Date.now();
            const promises = Array.from({ length: 100 }, () => extractScenarioTemplates({
                weather: 'severe',
                technology: 'down',
                staffing: 'short',
                building: 'emergency',
            }));
            const results = await Promise.all(promises);
            const duration = Date.now() - start;
            expect(results.every(result => result.recommendedScenario?.id === 'lockdown')).toBe(true);
            expect(duration).toBeLessThan(1000); // Should complete within 1 second
        });
        it('should handle multiple autoDetection calls efficiently', async () => {
            const start = Date.now();
            const promises = Array.from({ length: 50 }, (_, i) => autoDetectScenario(i + 1));
            const results = await Promise.all(promises);
            const duration = Date.now() - start;
            expect(results.every(result => result.id)).toBeTruthy();
            expect(duration).toBeLessThan(2000); // Should complete within 2 seconds
        });
        it('should handle large content generation efficiently', () => {
            const scenario = getScenarioById('general_emergency');
            const start = Date.now();
            const results = Array.from({ length: 1000 }, (_, i) => generateScenarioContent(scenario, `Teacher${i}`, `Class${i}`));
            const duration = Date.now() - start;
            expect(results.every(result => result.includes('Teacher'))).toBe(true);
            expect(duration).toBeLessThan(1000); // Should be very fast
        });
        it('should not leak memory during repeated operations', () => {
            const beforeMemory = process.memoryUsage().heapUsed;
            // Perform many operations
            for (let i = 0; i < 1000; i++) {
                const scenario = getScenarioById('general_emergency');
                generateScenarioContent(scenario, `Teacher${i}`, `Class${i}`);
            }
            const afterMemory = process.memoryUsage().heapUsed;
            const memoryIncrease = afterMemory - beforeMemory;
            expect(memoryIncrease).toBeLessThan(5 * 1024 * 1024); // Less than 5MB increase
        });
    });
