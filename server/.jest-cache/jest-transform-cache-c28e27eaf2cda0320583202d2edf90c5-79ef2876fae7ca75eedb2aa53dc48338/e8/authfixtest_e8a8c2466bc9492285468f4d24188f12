import { describe, it, expect, beforeAll } from '@jest/globals';
import request from 'supertest';
import bcrypt from 'bcryptjs';
import express from 'express';
import cookieParser from 'cookie-parser';
import { login } from '../../src/middleware/auth';
import { errorHandler } from '../../src/middleware/errorHandler';
import { applySecurityMiddleware } from '../../src/middleware/security';
import { getTestPrismaClient } from '../jest.setup';
describe('Auth Fix Test', () => {
    let app;
    let prisma;
    beforeAll(async () => {
        process.env.JWT_SECRET = 'test-secret';
        process.env.NODE_ENV = 'test';
        prisma = getTestPrismaClient();
    });
    beforeEach(async () => {
        // Create fresh app
        app = express();
        app.use(express.json());
        app.use(cookieParser());
        applySecurityMiddleware(app);
        app.post('/api/auth/login', login);
        app.use(errorHandler);
    });
    it('should login successfully with proper setup', async () => {
        // Clear any existing users
        await prisma.user.deleteMany();
        // Create user with known password
        const password = 'TestPassword123!';
        const hashedPassword = await bcrypt.hash(password, 10);
        const user = await prisma.user.create({
            data: {
                email: 'authfix@test.com',
                password: hashedPassword,
                name: 'Auth Fix Test',
                role: 'teacher',
            },
        });
        console.log('Created user:', { id: user.id, email: user.email });
        // Verify user exists in database
        const dbUser = await prisma.user.findUnique({
            where: { email: 'authfix@test.com' },
        });
        console.log('User in DB before login:', dbUser ? 'exists' : 'not found');
        // Try to login
        const response = await request(app)
            .post('/api/auth/login')
            .send({
            email: 'authfix@test.com',
            password: password,
        });
        console.log('Login response:', {
            status: response.status,
            body: response.body,
        });
        expect(response.status).toBe(200);
        expect(response.body).toHaveProperty('accessToken');
    });
});
