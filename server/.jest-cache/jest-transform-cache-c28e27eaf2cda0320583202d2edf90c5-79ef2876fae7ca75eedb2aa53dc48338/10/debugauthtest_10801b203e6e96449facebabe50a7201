/**
 * Debug Authentication Test
 * Simple test to debug authentication flow
 */
import { describe, it, expect, beforeEach } from '@jest/globals';
import request from 'supertest';
import { getTestPrismaClient } from '../jest.setup';
import bcrypt from 'bcryptjs';
// Import the actual app
let app;
beforeEach(async () => {
    // Set required environment variables
    process.env.JWT_SECRET = 'test-jwt-secret-for-debug';
    process.env.BCRYPT_SALT_ROUNDS = '10';
    const appModule = await import('../../src/index');
    app = appModule.app;
});
describe('Debug Authentication', () => {
    const testUser = {
        email: 'debug-test@example.com',
        password: 'DebugTestPassword123!',
        name: 'Debug Test User',
        role: 'teacher'
    };
    it('should create user and authenticate successfully', async () => {
        const prisma = getTestPrismaClient();
        // Step 1: Create user directly
        const saltRounds = parseInt(process.env.BCRYPT_SALT_ROUNDS || '10', 10);
        const hashedPassword = await bcrypt.hash(testUser.password, saltRounds);
        console.log('Creating user with email:', testUser.email);
        console.log('Hashed password length:', hashedPassword.length);
        console.log('Salt rounds used:', saltRounds);
        const user = await prisma.user.create({
            data: {
                email: testUser.email,
                password: hashedPassword,
                name: testUser.name,
                role: testUser.role,
            },
        });
        console.log('User created with ID:', user.id);
        // Step 2: Verify user exists
        const foundUser = await prisma.user.findUnique({
            where: { email: testUser.email }
        });
        console.log('User found after creation:', !!foundUser);
        console.log('Found user email:', foundUser?.email);
        console.log('Found user password format:', foundUser?.password.substring(0, 10) + '...');
        // Step 3: Test password verification manually
        const isPasswordValid = await bcrypt.compare(testUser.password, foundUser.password);
        console.log('Manual password verification:', isPasswordValid);
        // Step 4: Try to login
        const response = await request(app)
            .post('/api/auth/login')
            .send({
            email: testUser.email,
            password: testUser.password,
        });
        console.log('Login response status:', response.status);
        console.log('Login response body:', response.body);
        expect(response.status).toBe(200);
        expect(response.body.accessToken || response.body.token).toBeDefined();
    });
});
