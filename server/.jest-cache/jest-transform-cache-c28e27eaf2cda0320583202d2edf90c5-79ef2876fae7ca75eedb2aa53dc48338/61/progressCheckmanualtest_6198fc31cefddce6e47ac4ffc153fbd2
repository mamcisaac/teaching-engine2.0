import { jest } from '@jest/globals';
// Manual mock for prisma
const mockUnitPlanFindMany = jest.fn();
jest.doMock('../../../src/prisma', () => ({
    prisma: {
        unitPlan: {
            findMany: mockUnitPlanFindMany
        }
    }
}));
// Import after mocking
import { runProgressCheck } from '../../../src/jobs/progressCheck';
const mockWarn = jest.spyOn(console, 'warn').mockImplementation(() => { });
describe('Progress Check Job - Manual Mock', () => {
    beforeEach(() => {
        jest.clearAllMocks();
        mockUnitPlanFindMany.mockResolvedValue([]);
    });
    afterAll(() => {
        mockWarn.mockRestore();
    });
    it('should check unit plans and warn about upcoming lessons', async () => {
        const today = new Date();
        const futureDate = new Date(today.getTime() + 86400000);
        mockUnitPlanFindMany.mockResolvedValue([
            {
                id: 1,
                title: 'Test Unit Plan',
                endDate: futureDate,
                lessonPlans: [
                    { id: 1, date: futureDate }, // Future lesson
                ],
                user: { id: 1, name: 'Teacher 1' },
            },
        ]);
        await runProgressCheck();
        expect(mockUnitPlanFindMany).toHaveBeenCalled();
        expect(mockWarn).toHaveBeenCalledWith('Progress check notification: Unit Plan "Test Unit Plan" is ending soon with 1 upcoming lessons');
    });
    it('should handle empty results', async () => {
        mockUnitPlanFindMany.mockResolvedValue([]);
        await runProgressCheck();
        expect(mockUnitPlanFindMany).toHaveBeenCalled();
        expect(mockWarn).not.toHaveBeenCalled();
    });
});
