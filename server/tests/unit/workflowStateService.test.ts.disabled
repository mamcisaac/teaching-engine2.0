import { describe, it, expect, beforeEach, jest } from '@jest/globals';
import { 
  WorkflowStateService, 
  ETFOLevel, 
  ETFO_LEVEL_SEQUENCE, 
  ETFO_LEVEL_METADATA,
  WorkflowState,
  LevelProgress
} from '../../src/services/workflowStateService';
import { prisma } from '../../src/prisma';

// Mock Prisma
jest.mock('../../src/prisma', () => ({
  prisma: {
    curriculumExpectation: {
      count: jest.fn(),
    },
    longRangePlan: {
      count: jest.fn(),
    },
    unitPlan: {
      count: jest.fn(),
    },
    eTFOLessonPlan: {
      count: jest.fn(),
    },
    daybookEntry: {
      count: jest.fn(),
    },
    curriculumImport: {
      findUnique: jest.fn(),
    },
  },
}));

// Mock BaseService
jest.mock('../../src/services/base/BaseService', () => {
  return jest.fn().mockImplementation(() => ({
    logger: {
      error: jest.fn(),
      info: jest.fn(),
      warn: jest.fn(),
      debug: jest.fn(),
    },
  }));
});

const mockPrisma = prisma as jest.Mocked<typeof prisma>;

describe('WorkflowStateService', () => {
  let service: WorkflowStateService;
  const mockUserId = 1;

  beforeEach(() => {
    jest.clearAllMocks();
    service = new WorkflowStateService();
  });

  describe('ETFOLevel and Constants', () => {
    it('should have all required ETFO levels', () => {
      expect(ETFOLevel.CURRICULUM_EXPECTATIONS).toBe('CURRICULUM_EXPECTATIONS');
      expect(ETFOLevel.LONG_RANGE_PLANS).toBe('LONG_RANGE_PLANS');
      expect(ETFOLevel.UNIT_PLANS).toBe('UNIT_PLANS');
      expect(ETFOLevel.LESSON_PLANS).toBe('LESSON_PLANS');
      expect(ETFOLevel.DAYBOOK_ENTRIES).toBe('DAYBOOK_ENTRIES');
    });

    it('should have correct level sequence order', () => {
      expect(ETFO_LEVEL_SEQUENCE).toEqual([
        ETFOLevel.CURRICULUM_EXPECTATIONS,
        ETFOLevel.LONG_RANGE_PLANS,
        ETFOLevel.UNIT_PLANS,
        ETFOLevel.LESSON_PLANS,
        ETFOLevel.DAYBOOK_ENTRIES,
      ]);
    });

    it('should have metadata for all levels', () => {
      ETFO_LEVEL_SEQUENCE.forEach(level => {
        expect(ETFO_LEVEL_METADATA[level]).toBeDefined();
        expect(ETFO_LEVEL_METADATA[level]).toHaveProperty('name');
        expect(ETFO_LEVEL_METADATA[level]).toHaveProperty('description');
        expect(ETFO_LEVEL_METADATA[level]).toHaveProperty('requiredFields');
        expect(ETFO_LEVEL_METADATA[level]).toHaveProperty('completionCriteria');
      });
    });
  });

  describe('getUserWorkflowState', () => {
    beforeEach(() => {
      // Mock all level progress calculations
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(2); // completed
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(4) // total
        .mockResolvedValueOnce(1); // completed
      mockPrisma.eTFOLessonPlan.count
        .mockResolvedValueOnce(10) // total
        .mockResolvedValueOnce(0); // completed
      mockPrisma.daybookEntry.count
        .mockResolvedValueOnce(15) // total
        .mockResolvedValueOnce(0); // completed
    });

    it('should return complete workflow state', async () => {
      const result = await service.getUserWorkflowState(mockUserId);

      expect(result).toHaveProperty('userId', mockUserId);
      expect(result).toHaveProperty('currentLevel');
      expect(result).toHaveProperty('completedLevels');
      expect(result).toHaveProperty('accessibleLevels');
      expect(result).toHaveProperty('blockedLevels');
      expect(result).toHaveProperty('progress');
      expect(result.progress).toHaveLength(5);
    });

    it('should identify current level correctly', async () => {
      const result = await service.getUserWorkflowState(mockUserId);

      // With curriculum complete but long-range incomplete, current should be LONG_RANGE_PLANS
      expect(result.currentLevel).toBe(ETFOLevel.LONG_RANGE_PLANS);
    });

    it('should identify completed levels correctly', async () => {
      const result = await service.getUserWorkflowState(mockUserId);

      expect(result.completedLevels).toContain(ETFOLevel.CURRICULUM_EXPECTATIONS);
      expect(result.completedLevels).toContain(ETFOLevel.LONG_RANGE_PLANS);
      expect(result.completedLevels).not.toContain(ETFOLevel.UNIT_PLANS);
    });

    it('should identify accessible levels correctly', async () => {
      const result = await service.getUserWorkflowState(mockUserId);

      expect(result.accessibleLevels).toContain(ETFOLevel.CURRICULUM_EXPECTATIONS);
      expect(result.accessibleLevels).toContain(ETFOLevel.LONG_RANGE_PLANS);
      expect(result.accessibleLevels).toContain(ETFOLevel.UNIT_PLANS);
      expect(result.accessibleLevels).not.toContain(ETFOLevel.LESSON_PLANS);
    });

    it('should identify blocked levels correctly', async () => {
      const result = await service.getUserWorkflowState(mockUserId);

      expect(result.blockedLevels).toContain(ETFOLevel.LESSON_PLANS);
      expect(result.blockedLevels).toContain(ETFOLevel.DAYBOOK_ENTRIES);
      expect(result.blockedLevels).not.toContain(ETFOLevel.CURRICULUM_EXPECTATIONS);
    });

    it('should handle empty state (no progress)', async () => {
      // Mock all counts as 0
      mockPrisma.curriculumExpectation.count.mockResolvedValue(0);
      mockPrisma.longRangePlan.count.mockResolvedValue(0);
      mockPrisma.unitPlan.count.mockResolvedValue(0);
      mockPrisma.eTFOLessonPlan.count.mockResolvedValue(0);
      mockPrisma.daybookEntry.count.mockResolvedValue(0);

      const result = await service.getUserWorkflowState(mockUserId);

      expect(result.currentLevel).toBe(ETFOLevel.CURRICULUM_EXPECTATIONS);
      expect(result.completedLevels).toHaveLength(0);
      expect(result.accessibleLevels).toEqual([ETFOLevel.CURRICULUM_EXPECTATIONS]);
      expect(result.blockedLevels).toHaveLength(4);
    });

    it('should handle all levels complete', async () => {
      // Mock all levels as complete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
      mockPrisma.longRangePlan.count.mockResolvedValue(3);
      mockPrisma.unitPlan.count.mockResolvedValue(4);
      mockPrisma.eTFOLessonPlan.count.mockResolvedValue(10);
      mockPrisma.daybookEntry.count.mockResolvedValue(15);

      const result = await service.getUserWorkflowState(mockUserId);

      expect(result.completedLevels).toHaveLength(5);
      expect(result.accessibleLevels).toHaveLength(5);
      expect(result.blockedLevels).toHaveLength(0);
      expect(result.currentLevel).toBe(ETFOLevel.DAYBOOK_ENTRIES);
    });

    it('should handle database errors gracefully', async () => {
      mockPrisma.curriculumExpectation.count.mockRejectedValue(new Error('Database error'));

      await expect(service.getUserWorkflowState(mockUserId))
        .rejects.toThrow('Database error');

      expect(service.logger.error).toHaveBeenCalledWith(
        expect.objectContaining({
          error: expect.any(Error),
          userId: mockUserId,
        }),
        'Failed to get user workflow state'
      );
    });
  });

  describe('canAccessLevel', () => {
    it('should allow access to first level (CURRICULUM_EXPECTATIONS)', async () => {
      const result = await service.canAccessLevel(mockUserId, ETFOLevel.CURRICULUM_EXPECTATIONS);

      expect(result.canAccess).toBe(true);
      expect(result.reason).toBeUndefined();
    });

    it('should allow access when all previous levels are complete', async () => {
      // Mock curriculum and long-range as complete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(2); // completed

      const result = await service.canAccessLevel(mockUserId, ETFOLevel.UNIT_PLANS);

      expect(result.canAccess).toBe(true);
      expect(result.reason).toBeUndefined();
    });

    it('should deny access when previous level is incomplete', async () => {
      // Mock curriculum as incomplete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(0);

      const result = await service.canAccessLevel(mockUserId, ETFOLevel.LONG_RANGE_PLANS);

      expect(result.canAccess).toBe(false);
      expect(result.reason).toBe('Must complete Curriculum Expectations first');
    });

    it('should deny access when multiple previous levels are incomplete', async () => {
      // Mock curriculum as complete but long-range as incomplete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(0); // completed

      const result = await service.canAccessLevel(mockUserId, ETFOLevel.LESSON_PLANS);

      expect(result.canAccess).toBe(false);
      expect(result.reason).toBe('Must complete Long-Range Plans first');
    });

    it('should handle database errors gracefully', async () => {
      mockPrisma.curriculumExpectation.count.mockRejectedValue(new Error('Database error'));

      const result = await service.canAccessLevel(mockUserId, ETFOLevel.LONG_RANGE_PLANS);

      expect(result.canAccess).toBe(false);
      expect(result.reason).toBe('Error checking access permissions');
      expect(service.logger.error).toHaveBeenCalledWith(
        expect.objectContaining({
          error: expect.any(Error),
          userId: mockUserId,
          level: ETFOLevel.LONG_RANGE_PLANS,
        }),
        'Failed to check level access'
      );
    });

    it('should handle invalid level gracefully', async () => {
      const result = await service.canAccessLevel(mockUserId, 'INVALID_LEVEL' as ETFOLevel);

      expect(result.canAccess).toBe(false);
      expect(result.reason).toBe('Error checking access permissions');
    });
  });

  describe('calculateLevelProgress - Curriculum Expectations', () => {
    it('should calculate progress correctly when expectations exist', async () => {
      mockPrisma.curriculumExpectation.count.mockResolvedValue(10);

      const progress = await (service as any).calculateCurriculumProgress(mockUserId);

      expect(progress).toEqual({
        level: ETFOLevel.CURRICULUM_EXPECTATIONS,
        isComplete: true,
        isAccessible: true,
        progressPercentage: 100,
        completedItems: 10,
        totalItems: 10,
      });
    });

    it('should handle no expectations', async () => {
      mockPrisma.curriculumExpectation.count.mockResolvedValue(0);

      const progress = await (service as any).calculateCurriculumProgress(mockUserId);

      expect(progress).toEqual({
        level: ETFOLevel.CURRICULUM_EXPECTATIONS,
        isComplete: false,
        isAccessible: true,
        progressPercentage: 0,
        completedItems: 0,
        totalItems: 1, // Minimum 1 to avoid division by zero
      });
    });
  });

  describe('calculateLevelProgress - Long Range Plans', () => {
    beforeEach(() => {
      // Mock curriculum as complete for accessibility
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
    });

    it('should calculate progress correctly when plans exist with goals', async () => {
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(4) // total
        .mockResolvedValueOnce(3); // completed (with goals)

      const progress = await (service as any).calculateLongRangeProgress(mockUserId);

      expect(progress).toEqual({
        level: ETFOLevel.LONG_RANGE_PLANS,
        isComplete: true,
        isAccessible: true,
        progressPercentage: 75,
        completedItems: 3,
        totalItems: 4,
        blockedReason: undefined,
      });
    });

    it('should handle incomplete plans (no goals)', async () => {
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(0); // completed (with goals)

      const progress = await (service as any).calculateLongRangeProgress(mockUserId);

      expect(progress).toEqual({
        level: ETFOLevel.LONG_RANGE_PLANS,
        isComplete: false,
        isAccessible: true,
        progressPercentage: 0,
        completedItems: 0,
        totalItems: 3,
        blockedReason: undefined,
      });
    });

    it('should handle blocked state when curriculum incomplete', async () => {
      mockPrisma.curriculumExpectation.count.mockResolvedValue(0); // curriculum incomplete
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(2) // total
        .mockResolvedValueOnce(1); // completed

      const progress = await (service as any).calculateLongRangeProgress(mockUserId);

      expect(progress.isAccessible).toBe(false);
      expect(progress.blockedReason).toBe('Complete Curriculum Expectations first');
    });
  });

  describe('calculateLevelProgress - Unit Plans', () => {
    beforeEach(() => {
      // Mock previous levels as complete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(2); // completed
    });

    it('should calculate progress correctly when units have big ideas and expectations', async () => {
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(5) // total
        .mockResolvedValueOnce(4); // completed (with bigIdeas and expectations)

      const progress = await (service as any).calculateUnitProgress(mockUserId);

      expect(progress).toEqual({
        level: ETFOLevel.UNIT_PLANS,
        isComplete: true,
        isAccessible: true,
        progressPercentage: 80,
        completedItems: 4,
        totalItems: 5,
        blockedReason: undefined,
      });
    });

    it('should handle incomplete units', async () => {
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(0); // completed

      const progress = await (service as any).calculateUnitProgress(mockUserId);

      expect(progress.isComplete).toBe(false);
      expect(progress.progressPercentage).toBe(0);
    });

    it('should handle blocked state when long-range plans incomplete', async () => {
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(0); // completed (long-range incomplete)
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(2) // total
        .mockResolvedValueOnce(1); // completed

      const progress = await (service as any).calculateUnitProgress(mockUserId);

      expect(progress.isAccessible).toBe(false);
      expect(progress.blockedReason).toBe('Complete Long-Range Plans first');
    });
  });

  describe('calculateLevelProgress - Lesson Plans', () => {
    beforeEach(() => {
      // Mock previous levels as complete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(2); // completed
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(4) // total
        .mockResolvedValueOnce(3); // completed
    });

    it('should calculate progress correctly when lessons have required fields', async () => {
      mockPrisma.eTFOLessonPlan.count
        .mockResolvedValueOnce(8) // total
        .mockResolvedValueOnce(6); // completed (with learningGoals and materials)

      const progress = await (service as any).calculateLessonProgress(mockUserId);

      expect(progress).toEqual({
        level: ETFOLevel.LESSON_PLANS,
        isComplete: true,
        isAccessible: true,
        progressPercentage: 75,
        completedItems: 6,
        totalItems: 8,
        blockedReason: undefined,
      });
    });

    it('should handle blocked state when unit plans incomplete', async () => {
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(4) // total
        .mockResolvedValueOnce(0); // completed (units incomplete)
      mockPrisma.eTFOLessonPlan.count
        .mockResolvedValueOnce(5) // total
        .mockResolvedValueOnce(2); // completed

      const progress = await (service as any).calculateLessonProgress(mockUserId);

      expect(progress.isAccessible).toBe(false);
      expect(progress.blockedReason).toBe('Complete Unit Plans first');
    });
  });

  describe('calculateLevelProgress - Daybook Entries', () => {
    beforeEach(() => {
      // Mock all previous levels as complete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(2); // completed
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(4) // total
        .mockResolvedValueOnce(3); // completed
      mockPrisma.eTFOLessonPlan.count
        .mockResolvedValueOnce(8) // total
        .mockResolvedValueOnce(6); // completed
    });

    it('should calculate progress correctly when entries have reflections', async () => {
      mockPrisma.daybookEntry.count
        .mockResolvedValueOnce(20) // total
        .mockResolvedValueOnce(15); // completed (with whatWorked)

      const progress = await (service as any).calculateDaybookProgress(mockUserId);

      expect(progress).toEqual({
        level: ETFOLevel.DAYBOOK_ENTRIES,
        isComplete: true,
        isAccessible: true,
        progressPercentage: 75,
        completedItems: 15,
        totalItems: 20,
        blockedReason: undefined,
      });
    });

    it('should handle blocked state when lesson plans incomplete', async () => {
      mockPrisma.eTFOLessonPlan.count
        .mockResolvedValueOnce(8) // total
        .mockResolvedValueOnce(0); // completed (lessons incomplete)
      mockPrisma.daybookEntry.count
        .mockResolvedValueOnce(10) // total
        .mockResolvedValueOnce(5); // completed

      const progress = await (service as any).calculateDaybookProgress(mockUserId);

      expect(progress.isAccessible).toBe(false);
      expect(progress.blockedReason).toBe('Complete Lesson Plans first');
    });
  });

  describe('validateLevelCompletion', () => {
    describe('Curriculum Expectations validation', () => {
      const mockExpectation = {
        id: 'expectation-1',
        code: 'MATH.1.NS.1',
        description: 'Count to 20',
        strand: 'Number Sense',
      };

      it('should validate complete curriculum expectation', async () => {
        mockPrisma.curriculumExpectation.findUnique.mockResolvedValue(mockExpectation);

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.CURRICULUM_EXPECTATIONS,
          'expectation-1'
        );

        expect(result.isValid).toBe(true);
        expect(result.missingFields).toHaveLength(0);
      });

      it('should identify missing required fields', async () => {
        mockPrisma.curriculumExpectation.findUnique.mockResolvedValue({
          ...mockExpectation,
          code: null,
          strand: null,
        });

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.CURRICULUM_EXPECTATIONS,
          'expectation-1'
        );

        expect(result.isValid).toBe(false);
        expect(result.missingFields).toContain('code');
        expect(result.missingFields).toContain('strand');
        expect(result.missingFields).not.toContain('description');
      });

      it('should handle non-existent entity', async () => {
        mockPrisma.curriculumExpectation.findUnique.mockResolvedValue(null);

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.CURRICULUM_EXPECTATIONS,
          'non-existent'
        );

        expect(result.isValid).toBe(false);
        expect(result.missingFields).toContain('entity not found');
      });
    });

    describe('Long Range Plans validation', () => {
      const mockLRP = {
        id: 'lrp-1',
        title: 'Grade 3 Math Year Plan',
        goals: { goal1: 'Develop number sense', goal2: 'Problem solving' },
      };

      it('should validate complete long range plan', async () => {
        mockPrisma.longRangePlan.findUnique.mockResolvedValue(mockLRP);

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.LONG_RANGE_PLANS,
          'lrp-1'
        );

        expect(result.isValid).toBe(true);
        expect(result.missingFields).toHaveLength(0);
      });

      it('should identify missing goals', async () => {
        mockPrisma.longRangePlan.findUnique.mockResolvedValue({
          ...mockLRP,
          goals: null,
        });

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.LONG_RANGE_PLANS,
          'lrp-1'
        );

        expect(result.isValid).toBe(false);
        expect(result.missingFields).toContain('goals');
      });
    });

    describe('Unit Plans validation', () => {
      const mockUnit = {
        id: 'unit-1',
        title: 'Fractions Unit',
        bigIdeas: 'Fractions represent parts of a whole',
        expectations: [{ id: 'exp-1' }], // Has expectations
      };

      it('should validate complete unit plan', async () => {
        mockPrisma.unitPlan.findUnique.mockResolvedValue(mockUnit);

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.UNIT_PLANS,
          'unit-1'
        );

        expect(result.isValid).toBe(true);
        expect(result.missingFields).toHaveLength(0);
      });

      it('should identify missing big ideas and expectations', async () => {
        mockPrisma.unitPlan.findUnique.mockResolvedValue({
          ...mockUnit,
          bigIdeas: null,
          expectations: [], // No expectations
        });

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.UNIT_PLANS,
          'unit-1'
        );

        expect(result.isValid).toBe(false);
        expect(result.missingFields).toContain('bigIdeas');
        expect(result.missingFields).toContain('expectations');
      });
    });

    describe('Lesson Plans validation', () => {
      const mockLesson = {
        id: 'lesson-1',
        title: 'Introduction to Fractions',
        learningGoals: ['Students will understand fractions'],
        materials: ['Fraction blocks', 'Worksheets'],
      };

      it('should validate complete lesson plan', async () => {
        mockPrisma.eTFOLessonPlan.findUnique.mockResolvedValue(mockLesson);

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.LESSON_PLANS,
          'lesson-1'
        );

        expect(result.isValid).toBe(true);
        expect(result.missingFields).toHaveLength(0);
      });

      it('should identify missing learning goals and materials', async () => {
        mockPrisma.eTFOLessonPlan.findUnique.mockResolvedValue({
          ...mockLesson,
          learningGoals: null,
          materials: null,
        });

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.LESSON_PLANS,
          'lesson-1'
        );

        expect(result.isValid).toBe(false);
        expect(result.missingFields).toContain('learningGoals');
        expect(result.missingFields).toContain('materials');
      });
    });

    describe('Daybook Entries validation', () => {
      const mockDaybook = {
        id: 'daybook-1',
        date: new Date('2024-01-15'),
        whatWorked: 'Students engaged well with manipulatives',
        whatDidntWork: null,
      };

      it('should validate complete daybook entry', async () => {
        mockPrisma.daybookEntry.findUnique.mockResolvedValue(mockDaybook);

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.DAYBOOK_ENTRIES,
          'daybook-1'
        );

        expect(result.isValid).toBe(true);
        expect(result.missingFields).toHaveLength(0);
      });

      it('should require at least one reflection field', async () => {
        mockPrisma.daybookEntry.findUnique.mockResolvedValue({
          ...mockDaybook,
          whatWorked: null,
          whatDidntWork: null,
        });

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.DAYBOOK_ENTRIES,
          'daybook-1'
        );

        expect(result.isValid).toBe(false);
        expect(result.missingFields).toContain('reflections');
      });

      it('should handle missing date', async () => {
        mockPrisma.daybookEntry.findUnique.mockResolvedValue({
          ...mockDaybook,
          date: null,
        });

        const result = await service.validateLevelCompletion(
          mockUserId,
          ETFOLevel.DAYBOOK_ENTRIES,
          'daybook-1'
        );

        expect(result.isValid).toBe(false);
        expect(result.missingFields).toContain('date');
      });
    });

    it('should handle database errors in validation', async () => {
      mockPrisma.curriculumExpectation.findUnique.mockRejectedValue(new Error('Database error'));

      const result = await service.validateLevelCompletion(
        mockUserId,
        ETFOLevel.CURRICULUM_EXPECTATIONS,
        'expectation-1'
      );

      expect(result.isValid).toBe(false);
      expect(result.missingFields).toEqual(['validation error']);
      expect(service.logger.error).toHaveBeenCalledWith(
        expect.objectContaining({
          error: expect.any(Error),
          userId: mockUserId,
          level: ETFOLevel.CURRICULUM_EXPECTATIONS,
          entityId: 'expectation-1',
        }),
        'Failed to validate level completion'
      );
    });
  });

  describe('Helper Methods', () => {
    describe('getCompletedLevels', () => {
      it('should return only completed levels', () => {
        const progress: LevelProgress[] = [
          {
            level: ETFOLevel.CURRICULUM_EXPECTATIONS,
            isComplete: true,
            isAccessible: true,
            progressPercentage: 100,
            completedItems: 5,
            totalItems: 5,
          },
          {
            level: ETFOLevel.LONG_RANGE_PLANS,
            isComplete: false,
            isAccessible: true,
            progressPercentage: 50,
            completedItems: 1,
            totalItems: 2,
          },
          {
            level: ETFOLevel.UNIT_PLANS,
            isComplete: true,
            isAccessible: true,
            progressPercentage: 100,
            completedItems: 3,
            totalItems: 3,
          },
        ];

        const completed = (service as any).getCompletedLevels(progress);

        expect(completed).toEqual([
          ETFOLevel.CURRICULUM_EXPECTATIONS,
          ETFOLevel.UNIT_PLANS,
        ]);
      });
    });

    describe('getCurrentLevel', () => {
      it('should return first incomplete but accessible level', () => {
        const progress: LevelProgress[] = [
          {
            level: ETFOLevel.CURRICULUM_EXPECTATIONS,
            isComplete: true,
            isAccessible: true,
            progressPercentage: 100,
            completedItems: 5,
            totalItems: 5,
          },
          {
            level: ETFOLevel.LONG_RANGE_PLANS,
            isComplete: false,
            isAccessible: true,
            progressPercentage: 50,
            completedItems: 1,
            totalItems: 2,
          },
          {
            level: ETFOLevel.UNIT_PLANS,
            isComplete: false,
            isAccessible: false,
            progressPercentage: 0,
            completedItems: 0,
            totalItems: 1,
          },
        ];

        const current = (service as any).getCurrentLevel(progress);

        expect(current).toBe(ETFOLevel.LONG_RANGE_PLANS);
      });

      it('should return last completed level when all accessible are complete', () => {
        const progress: LevelProgress[] = [
          {
            level: ETFOLevel.CURRICULUM_EXPECTATIONS,
            isComplete: true,
            isAccessible: true,
            progressPercentage: 100,
            completedItems: 5,
            totalItems: 5,
          },
          {
            level: ETFOLevel.LONG_RANGE_PLANS,
            isComplete: true,
            isAccessible: true,
            progressPercentage: 100,
            completedItems: 2,
            totalItems: 2,
          },
          {
            level: ETFOLevel.UNIT_PLANS,
            isComplete: false,
            isAccessible: false,
            progressPercentage: 0,
            completedItems: 0,
            totalItems: 1,
          },
        ];

        const current = (service as any).getCurrentLevel(progress);

        expect(current).toBe(ETFOLevel.LONG_RANGE_PLANS);
      });

      it('should default to first level when no progress', () => {
        const progress: LevelProgress[] = [
          {
            level: ETFOLevel.CURRICULUM_EXPECTATIONS,
            isComplete: false,
            isAccessible: true,
            progressPercentage: 0,
            completedItems: 0,
            totalItems: 1,
          },
        ];

        const current = (service as any).getCurrentLevel(progress);

        expect(current).toBe(ETFOLevel.CURRICULUM_EXPECTATIONS);
      });
    });

    describe('getAccessibleLevels', () => {
      it('should return only accessible levels', () => {
        const progress: LevelProgress[] = [
          {
            level: ETFOLevel.CURRICULUM_EXPECTATIONS,
            isComplete: true,
            isAccessible: true,
            progressPercentage: 100,
            completedItems: 5,
            totalItems: 5,
          },
          {
            level: ETFOLevel.LONG_RANGE_PLANS,
            isComplete: false,
            isAccessible: true,
            progressPercentage: 50,
            completedItems: 1,
            totalItems: 2,
          },
          {
            level: ETFOLevel.UNIT_PLANS,
            isComplete: false,
            isAccessible: false,
            progressPercentage: 0,
            completedItems: 0,
            totalItems: 1,
            blockedReason: 'Complete Long-Range Plans first',
          },
        ];

        const accessible = (service as any).getAccessibleLevels(progress);

        expect(accessible).toEqual([
          ETFOLevel.CURRICULUM_EXPECTATIONS,
          ETFOLevel.LONG_RANGE_PLANS,
        ]);
      });
    });

    describe('getBlockedLevels', () => {
      it('should return only blocked levels', () => {
        const progress: LevelProgress[] = [
          {
            level: ETFOLevel.CURRICULUM_EXPECTATIONS,
            isComplete: true,
            isAccessible: true,
            progressPercentage: 100,
            completedItems: 5,
            totalItems: 5,
          },
          {
            level: ETFOLevel.LONG_RANGE_PLANS,
            isComplete: false,
            isAccessible: true,
            progressPercentage: 50,
            completedItems: 1,
            totalItems: 2,
          },
          {
            level: ETFOLevel.UNIT_PLANS,
            isComplete: false,
            isAccessible: false,
            progressPercentage: 0,
            completedItems: 0,
            totalItems: 1,
            blockedReason: 'Complete Long-Range Plans first',
          },
          {
            level: ETFOLevel.LESSON_PLANS,
            isComplete: false,
            isAccessible: false,
            progressPercentage: 0,
            completedItems: 0,
            totalItems: 1,
            blockedReason: 'Complete Unit Plans first',
          },
        ];

        const blocked = (service as any).getBlockedLevels(progress);

        expect(blocked).toEqual([
          ETFOLevel.UNIT_PLANS,
          ETFOLevel.LESSON_PLANS,
        ]);
      });
    });
  });

  describe('Edge Cases and Error Handling', () => {
    it('should handle division by zero in progress calculation', async () => {
      // Test when total items is 0
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(0) // total
        .mockResolvedValueOnce(0); // completed
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5); // accessible

      const progress = await (service as any).calculateLongRangeProgress(mockUserId);

      expect(progress.progressPercentage).toBe(0);
      expect(progress.totalItems).toBe(1); // Should default to 1
    });

    it('should handle invalid level in calculateLevelProgress', async () => {
      await expect((service as any).calculateLevelProgress(mockUserId, 'INVALID_LEVEL'))
        .rejects.toThrow('Unknown level: INVALID_LEVEL');
    });

    it('should handle null/undefined values in database responses', async () => {
      mockPrisma.curriculumExpectation.count.mockResolvedValue(null as any);

      // The service should handle null gracefully and convert to 0
      const result = await service.getUserWorkflowState(mockUserId);
      expect(result.userId).toBe(mockUserId);
    });

    it('should handle concurrent access issues', async () => {
      // Simulate a race condition where count changes between calls
      let callCount = 0;
      mockPrisma.longRangePlan.count.mockImplementation(() => {
        callCount++;
        return Promise.resolve(callCount); // Different values each call
      });
      mockPrisma.curriculumExpectation.count.mockResolvedValue(5);

      const progress = await (service as any).calculateLongRangeProgress(mockUserId);

      expect(progress.progressPercentage).toBeGreaterThanOrEqual(0);
      expect(progress.progressPercentage).toBeLessThanOrEqual(100);
    });
  });

  describe('Integration Scenarios', () => {
    it('should handle typical teacher progression scenario', async () => {
      // Scenario: Teacher has imported curriculum, created some long-range plans,
      // but hasn't completed unit plans yet
      
      // Reset all mocks to ensure clean state
      jest.clearAllMocks();
      
      // Mock curriculum complete
      mockPrisma.curriculumExpectation.count.mockResolvedValue(15);
      
      // Mock long-range plans in progress - both calls (isLevelComplete checks)
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(4) // total for calculateLongRangeProgress
        .mockResolvedValueOnce(2) // completed for calculateLongRangeProgress
        .mockResolvedValueOnce(4) // total for isLevelComplete check in calculateUnitProgress
        .mockResolvedValueOnce(2); // completed for isLevelComplete check in calculateUnitProgress
      
      // Mock unit plans started but not complete
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(3) // total
        .mockResolvedValueOnce(0); // completed
      
      // Mock no lesson plans or daybook entries yet
      mockPrisma.eTFOLessonPlan.count
        .mockResolvedValueOnce(0) // total
        .mockResolvedValueOnce(0); // completed
      mockPrisma.daybookEntry.count
        .mockResolvedValueOnce(0) // total  
        .mockResolvedValueOnce(0); // completed

      const state = await service.getUserWorkflowState(mockUserId);

      expect(state.completedLevels).toContain(ETFOLevel.CURRICULUM_EXPECTATIONS);
      expect(state.completedLevels).toContain(ETFOLevel.LONG_RANGE_PLANS);
      expect(state.currentLevel).toBe(ETFOLevel.UNIT_PLANS);
      expect(state.accessibleLevels).toContain(ETFOLevel.UNIT_PLANS);
      expect(state.blockedLevels).toContain(ETFOLevel.LESSON_PLANS);
      expect(state.blockedLevels).toContain(ETFOLevel.DAYBOOK_ENTRIES);
    });

    it('should handle new teacher with no progress', async () => {
      // All counts return 0
      mockPrisma.curriculumExpectation.count.mockResolvedValue(0);
      mockPrisma.longRangePlan.count.mockResolvedValue(0);
      mockPrisma.unitPlan.count.mockResolvedValue(0);
      mockPrisma.eTFOLessonPlan.count.mockResolvedValue(0);
      mockPrisma.daybookEntry.count.mockResolvedValue(0);

      const state = await service.getUserWorkflowState(mockUserId);

      expect(state.completedLevels).toHaveLength(0);
      expect(state.currentLevel).toBe(ETFOLevel.CURRICULUM_EXPECTATIONS);
      expect(state.accessibleLevels).toEqual([ETFOLevel.CURRICULUM_EXPECTATIONS]);
      expect(state.blockedLevels).toHaveLength(4);
    });

    it('should handle experienced teacher with all levels complete', async () => {
      // All levels have content
      jest.clearAllMocks();
      
      mockPrisma.curriculumExpectation.count.mockResolvedValue(25);
      
      // Mock long-range plans as complete (need multiple calls)
      mockPrisma.longRangePlan.count
        .mockResolvedValueOnce(5) // total for calculateLongRangeProgress
        .mockResolvedValueOnce(5) // completed for calculateLongRangeProgress
        .mockResolvedValueOnce(5) // total for isLevelComplete in calculateUnitProgress
        .mockResolvedValueOnce(5) // completed for isLevelComplete in calculateUnitProgress
        .mockResolvedValueOnce(5) // additional calls for other levels
        .mockResolvedValueOnce(5);
        
      mockPrisma.unitPlan.count
        .mockResolvedValueOnce(12) // total for calculateUnitProgress
        .mockResolvedValueOnce(12) // completed for calculateUnitProgress
        .mockResolvedValueOnce(12) // total for isLevelComplete in calculateLessonProgress
        .mockResolvedValueOnce(12) // completed for isLevelComplete in calculateLessonProgress
        .mockResolvedValueOnce(12) // additional calls
        .mockResolvedValueOnce(12);
        
      mockPrisma.eTFOLessonPlan.count
        .mockResolvedValueOnce(48) // total for calculateLessonProgress
        .mockResolvedValueOnce(48) // completed for calculateLessonProgress
        .mockResolvedValueOnce(48) // total for isLevelComplete in calculateDaybookProgress
        .mockResolvedValueOnce(48) // completed for isLevelComplete in calculateDaybookProgress
        .mockResolvedValueOnce(48) // additional calls
        .mockResolvedValueOnce(48);
        
      mockPrisma.daybookEntry.count
        .mockResolvedValueOnce(100) // total for calculateDaybookProgress
        .mockResolvedValueOnce(100); // completed for calculateDaybookProgress

      const state = await service.getUserWorkflowState(mockUserId);

      expect(state.completedLevels).toHaveLength(5);
      expect(state.accessibleLevels).toHaveLength(5);
      expect(state.blockedLevels).toHaveLength(0);
      expect(state.currentLevel).toBe(ETFOLevel.DAYBOOK_ENTRIES);
    });
  });
});