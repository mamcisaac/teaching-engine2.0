/**
 * Additional Test Coverage for Weekly Plan Extractor Service
 * 
 * Tests critical paths and edge cases that weren't covered in existing tests
 * to improve overall test coverage for the weekly planning functionality
 */

import { describe, it, expect, beforeEach, jest } from '@jest/globals';
import { extractWeeklyPlan } from '../../src/services/weeklyPlanExtractor';
import { startOfWeek, endOfWeek, addDays, format } from 'date-fns';

// Mock dependencies
jest.mock('../../src/services/subPlanService', () => ({
  buildSubPlanData: jest.fn().mockResolvedValue({
    date: '2024-03-01',
    dayName: 'Monday',
    schedule: [],
    subjects: [],
    learningGoals: [],
    notes: '',
    specialConsiderations: []
  }),
  SubPlanOptions: {}
}));

// Create a mock prisma client for this test
const mockPrismaClient = {
  user: {
    findUnique: jest.fn(),
    create: jest.fn(),
  },
  subject: {
    findMany: jest.fn(),
    create: jest.fn(),
  },
  milestone: {
    findMany: jest.fn(),
    create: jest.fn(),
  },
  activity: {
    findMany: jest.fn(),
  },
  longRangePlan: {
    findMany: jest.fn(),
  },
  unitPlan: {
    findMany: jest.fn(),
  },
  lessonPlan: {
    findMany: jest.fn(),
  },
  weeklySchedule: {
    findFirst: jest.fn(),
  },
};

// Mock the prisma module
jest.mock('../../src/prisma', () => ({
  prisma: mockPrismaClient,
}));

describe('WeeklyPlanExtractor Coverage Tests', () => {
  let mockUser: any;
  let mockSubjects: any[];
  let mockMilestones: any[];

  beforeEach(async () => {
    jest.clearAllMocks();
    
    // Create mock data
    mockUser = {
      id: 1,
      email: 'teacher@example.com',
      password: 'hashed_password',
      name: 'Test Teacher',
      role: 'teacher',
    };

    mockSubjects = [
      {
        id: 1,
        name: 'Mathematics',
        code: 'MATH',
        userId: mockUser.id,
          },
        }),
        prisma.subject.create({
          data: {
            name: 'Science',
            code: 'SCI',
            userId: user.id,
          },
        }),
      ]);

      // Create test milestones
      const milestones = await Promise.all([
        prisma.milestone.create({
          data: {
            title: 'Number Operations',
            subjectId: subjects[0].id,
            userId: user.id,
          },
        }),
        prisma.milestone.create({
          data: {
            title: 'Scientific Method',
            subjectId: subjects[1].id,
            userId: user.id,
          },
        }),
      ]);

      return { user, subjects, milestones };
    });

    mockUser = testData.user;
    mockSubjects = testData.subjects;
    mockMilestones = testData.milestones;
  });

  describe('Basic Weekly Plan Extraction', () => {
    it('should extract plan for a week with no data', async () => {
      const startDate = format(startOfWeek(new Date()), 'yyyy-MM-dd');
      const endDate = format(endOfWeek(new Date()), 'yyyy-MM-dd');

      const result = await extractWeeklyPlan(startDate, endDate, mockUser.id);

      expect(result).toBeDefined();
      expect(result.startDate).toBe(startDate);
      expect(result.endDate).toBe(endDate);
      expect(result.days).toHaveLength(7);
      expect(result.weeklyOverview).toBeDefined();
    });

    it('should handle invalid date formats', async () => {
      await expect(
        extractWeeklyPlan('invalid-date', '2024-03-08', mockUser.id)
      ).rejects.toThrow();
    });

    it('should handle end date before start date', async () => {
      await expect(
        extractWeeklyPlan('2024-03-08', '2024-03-01', mockUser.id)
      ).rejects.toThrow();
    });

    it('should handle date ranges longer than a week', async () => {
      const startDate = '2024-03-01';
      const endDate = '2024-03-15'; // Two weeks

      const result = await extractWeeklyPlan(startDate, endDate, mockUser.id);
      
      expect(result).toBeDefined();
      expect(result.days.length).toBeGreaterThan(7);
    });
  });

  describe('Weekly Overview Extraction', () => {
    it('should extract overview with unit plans', async () => {
      // Create unit plan
      await createTestData(async (prisma) => {
        const longRangePlan = await prisma.longRangePlan.create({
          data: {
            title: 'Year Plan',
            subject: 'Mathematics',
            grade: 5,
            yearStart: 2024,
            yearEnd: 2025,
            userId: mockUser.id,
          },
        });

        await prisma.unitPlan.create({
          data: {
            title: 'Fractions Unit',
            startDate: new Date('2024-03-01'),
            endDate: new Date('2024-03-15'),
            longRangePlanId: longRangePlan.id,
            userId: mockUser.id,
          },
        });
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result.weeklyOverview.unitPlans).toHaveLength(1);
      expect(result.weeklyOverview.unitPlans[0].title).toBe('Fractions Unit');
    });

    it('should include assessments in overview', async () => {
      // Create assessment data
      await createTestData(async (prisma) => {
        await prisma.assessment.create({
          data: {
            title: 'Math Quiz',
            type: 'quiz',
            subject: 'Mathematics',
            scheduledDate: new Date('2024-03-05'),
            userId: mockUser.id,
          },
        });
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result.weeklyOverview.assessments).toHaveLength(1);
      expect(result.weeklyOverview.assessments[0].title).toBe('Math Quiz');
    });

    it('should calculate subject hours correctly', async () => {
      // Create lesson plans with different subjects
      await createTestData(async (prisma) => {
        const longRangePlan = await prisma.longRangePlan.create({
          data: {
            title: 'Year Plan',
            subject: 'Mathematics',
            grade: 5,
            yearStart: 2024,
            yearEnd: 2025,
            userId: mockUser.id,
          },
        });

        const unitPlan = await prisma.unitPlan.create({
          data: {
            title: 'Math Unit',
            startDate: new Date('2024-03-01'),
            endDate: new Date('2024-03-15'),
            longRangePlanId: longRangePlan.id,
            userId: mockUser.id,
          },
        });

        await Promise.all([
          prisma.lessonPlan.create({
            data: {
              title: 'Math Lesson 1',
              duration: 60,
              date: new Date('2024-03-04'),
              unitPlanId: unitPlan.id,
              userId: mockUser.id,
            },
          }),
          prisma.lessonPlan.create({
            data: {
              title: 'Math Lesson 2',
              duration: 45,
              date: new Date('2024-03-06'),
              unitPlanId: unitPlan.id,
              userId: mockUser.id,
            },
          }),
        ]);
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      const mathSubject = result.weeklyOverview.subjects.find(s => s.name === 'Mathematics');
      expect(mathSubject).toBeDefined();
      if (mathSubject) {
        expect(mathSubject.totalHours).toBeGreaterThan(0);
      }
    });
  });

  describe('Continuity Notes', () => {
    it('should generate continuity notes for connected lessons', async () => {
      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result.continuityNotes).toBeDefined();
      expect(Array.isArray(result.continuityNotes)).toBe(true);
    });

    it('should link activities across days', async () => {
      // Create connected activities
      await createTestData(async (prisma) => {
        const activity1 = await prisma.activity.create({
          data: {
            title: 'Introduction to Fractions',
            milestoneId: mockMilestones[0].id,
            userId: mockUser.id,
          },
        });

        await prisma.activity.create({
          data: {
            title: 'Fractions Practice',
            milestoneId: mockMilestones[0].id,
            previousActivityId: activity1.id,
            userId: mockUser.id,
          },
        });
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result.continuityNotes.length).toBeGreaterThan(0);
    });
  });

  describe('Emergency Backup Plans', () => {
    it('should include emergency backup plans', async () => {
      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result.emergencyBackupPlans).toBeDefined();
      expect(Array.isArray(result.emergencyBackupPlans)).toBe(true);
    });

    it('should generate subject-specific backup activities', async () => {
      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      if (result.emergencyBackupPlans.length > 0) {
        const mathBackup = result.emergencyBackupPlans.find(
          plan => plan.subject === 'Mathematics'
        );
        expect(mathBackup).toBeDefined();
        if (mathBackup) {
          expect(mathBackup.activities.length).toBeGreaterThan(0);
        }
      }
    });
  });

  describe('Special Events Handling', () => {
    it('should include special events in the overview', async () => {
      await createTestData(async (prisma) => {
        await prisma.specialEvent.create({
          data: {
            title: 'Field Trip',
            date: new Date('2024-03-05'),
            impact: 'No afternoon classes',
            userId: mockUser.id,
          },
        });
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result.weeklyOverview.specialEvents).toHaveLength(1);
      expect(result.weeklyOverview.specialEvents[0].title).toBe('Field Trip');
    });

    it('should handle multiple special events on same day', async () => {
      await createTestData(async (prisma) => {
        await Promise.all([
          prisma.specialEvent.create({
            data: {
              title: 'Morning Assembly',
              date: new Date('2024-03-05'),
              time: '9:00 AM',
              impact: 'First period shortened',
              userId: mockUser.id,
            },
          }),
          prisma.specialEvent.create({
            data: {
              title: 'Parent-Teacher Meeting',
              date: new Date('2024-03-05'),
              time: '3:00 PM',
              impact: 'Early dismissal',
              userId: mockUser.id,
            },
          }),
        ]);
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result.weeklyOverview.specialEvents).toHaveLength(2);
    });
  });

  describe('Edge Cases and Error Handling', () => {
    it('should handle user with no data gracefully', async () => {
      const newUser = await createTestData(async (prisma) => {
        return await prisma.user.create({
          data: {
            email: 'empty@example.com',
            password: 'hashed_password',
            name: 'Empty User',
            role: 'teacher',
          },
        });
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', newUser.id);

      expect(result).toBeDefined();
      expect(result.days).toHaveLength(7);
      expect(result.weeklyOverview.subjects).toHaveLength(0);
      expect(result.weeklyOverview.unitPlans).toHaveLength(0);
    });

    it('should handle partial week extraction', async () => {
      // Extract only Monday to Wednesday
      const result = await extractWeeklyPlan('2024-03-04', '2024-03-06', mockUser.id);

      expect(result).toBeDefined();
      expect(result.days).toHaveLength(3);
    });

    it('should handle year boundary crossing', async () => {
      // Week spanning from December to January
      const result = await extractWeeklyPlan('2023-12-28', '2024-01-03', mockUser.id);

      expect(result).toBeDefined();
      expect(result.days).toHaveLength(7);
    });

    it('should handle database errors gracefully', async () => {
      const prisma = getTestPrismaClient();
      const originalFind = prisma.unitPlan.findMany;
      prisma.unitPlan.findMany = jest.fn().mockRejectedValue(new Error('Database error'));

      // Should still return a result, possibly with empty data
      await expect(
        extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id)
      ).rejects.toThrow('Database error');

      // Restore original method
      prisma.unitPlan.findMany = originalFind;
    });
  });

  describe('Performance with Large Datasets', () => {
    it('should handle weeks with many activities efficiently', async () => {
      // Create many activities for the week
      await createTestData(async (prisma) => {
        const activities = [];
        for (let i = 0; i < 50; i++) {
          activities.push({
            title: `Activity ${i}`,
            milestoneId: mockMilestones[i % 2].id,
            userId: mockUser.id,
          });
        }
        await prisma.activity.createMany({ data: activities });
      });

      const start = Date.now();
      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);
      const duration = Date.now() - start;

      expect(result).toBeDefined();
      expect(duration).toBeLessThan(5000); // Should complete within 5 seconds
    });

    it('should efficiently handle multiple concurrent unit plans', async () => {
      // Create overlapping unit plans
      await createTestData(async (prisma) => {
        const longRangePlan = await prisma.longRangePlan.create({
          data: {
            title: 'Year Plan',
            subject: 'Multi-Subject',
            grade: 5,
            yearStart: 2024,
            yearEnd: 2025,
            userId: mockUser.id,
          },
        });

        const unitPlans = [];
        for (let i = 0; i < 10; i++) {
          unitPlans.push({
            title: `Unit ${i}`,
            startDate: addDays(new Date('2024-03-01'), i),
            endDate: addDays(new Date('2024-03-01'), i + 7),
            longRangePlanId: longRangePlan.id,
            userId: mockUser.id,
          });
        }
        await prisma.unitPlan.createMany({ data: unitPlans });
      });

      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id);

      expect(result).toBeDefined();
      expect(result.weeklyOverview.unitPlans.length).toBeGreaterThan(0);
    });
  });

  describe('Options and Customization', () => {
    it('should respect includeEmergencyPlans option', async () => {
      const options = { includeEmergencyPlans: false };
      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id, options);

      expect(result.emergencyBackupPlans).toHaveLength(0);
    });

    it('should respect detailed option for enhanced data', async () => {
      const options = { detailed: true };
      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id, options);

      expect(result).toBeDefined();
      // Detailed option should include more comprehensive data
      expect(result.weeklyOverview).toBeDefined();
    });

    it('should filter by subject when specified', async () => {
      const options = { subjectFilter: 'Mathematics' };
      const result = await extractWeeklyPlan('2024-03-01', '2024-03-08', mockUser.id, options);

      expect(result).toBeDefined();
      // All activities should be math-related
      result.weeklyOverview.subjects.forEach(subject => {
        expect(['Mathematics', 'General']).toContain(subject.name);
      });
    });
  });
});