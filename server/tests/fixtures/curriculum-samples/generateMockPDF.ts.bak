// Function to generate test PDF buffer (minimal valid PDF)
export function generateTestPDFBuffer(content: string = mockPDFContent.ontarioMathGrade4): Buffer {
  // This creates a minimal valid PDF structure
  // In real tests, you'd use a proper PDF library
  const pdfContent = `%PDF-1.4
1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj
2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj
3 0 obj
<< /Type /Page /Parent 2 0 R /Resources 4 0 R /MediaBox [0 0 612 792] /Contents 5 0 R >>
endobj
4 0 obj
<< /Font << /F1 << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> >> >>
endobj
5 0 obj
<< /Length ${content.length} >>
stream
${content}
endstream
endobj
xref
0 6
0000000000 65535 f
0000000009 00000 n
0000000058 00000 n
0000000115 00000 n
0000000229 00000 n
0000000328 00000 n
trailer
<< /Size 6 /Root 1 0 R >>
startxref
${350 + content.length}
%%EOF`;

  return Buffer.from(pdfContent);
}

// Function to generate test DOCX buffer
export function generateTestDOCXBuffer(content: string = mockDOCXContent.bilingualMathGrade3): Buffer {
  // For testing purposes, we'll just return the content as a buffer
  // In real tests, you'd use a proper DOCX library
  return Buffer.from(content);
}