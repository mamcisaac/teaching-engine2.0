{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node", "jest", "@jest/globals"],
    "lib": ["es2022"],
    "module": "ESNext",
    "target": "ES2022",
    "strict": false,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/*"],
      "@teaching-engine/database": ["tests/mocks/database.mock.ts"],
      "tests/*": ["tests/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "../shared/**/*", "jest.setup.js", "jest.config.js"],
  "exclude": ["node_modules", "dist"]
}
