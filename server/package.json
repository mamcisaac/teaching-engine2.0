{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SKIP_PRISMA_GENERATE=1 NODE_OPTIONS='--experimental-specifier-resolution=node --max-old-space-size=4096' tsx watch --ignore .watchignore --clear-screen=false --inspect=0.0.0.0:9229 src/index.ts",
    "start": "NODE_OPTIONS='--experimental-specifier-resolution=node' tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=2048' jest --detectOpenHandles",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=2048' TEST_TYPE=unit jest --passWithNoTests --runInBand=false --forceExit --detectOpenHandles",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=2048' TEST_TYPE=integration jest --passWithNoTests --runInBand --forceExit --detectOpenHandles",
    "test:ai-snapshots": "NODE_OPTIONS='--experimental-vm-modules' TEST_TYPE=ai-snapshots jest --passWithNoTests --detectOpenHandles",
    "test:performance": "NODE_OPTIONS='--experimental-vm-modules' TEST_TYPE=performance jest --passWithNoTests --detectOpenHandles",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' TEST_TYPE=all jest --coverage --maxWorkers=50% --detectOpenHandles",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=2048' jest --watch --maxWorkers=2 --detectOpenHandles",
    "test:debug": "NODE_OPTIONS='--experimental-vm-modules' DEBUG_TESTS=true jest --verbose --detectOpenHandles",
    "test:ci": "pnpm test:validate && NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest --ci --coverage --maxWorkers=2 --forceExit --detectOpenHandles",
    "test:all": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' TEST_TYPE=all jest --forceExit --detectOpenHandles",
    "test:parallel": "pnpm test:unit && pnpm test:integration",
    "test:comprehensive": "node scripts/run-all-tests.js",
    "test:benchmark": "node scripts/benchmark-optimizations.js",
    "test:monitor": "MONITOR_TEST_PERFORMANCE=true pnpm test:unit",
    "test:quick": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=2048' TEST_TYPE=unit jest --passWithNoTests --maxWorkers=4 --testTimeout=5000 --bail --detectOpenHandles",
    "test:contract": "pnpm test:pact && pnpm test:pact:verify",
    "test:fast": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=2048' TEST_TYPE=unit jest --passWithNoTests --maxWorkers=4 --testTimeout=5000 --bail=3 --detectOpenHandles",
    "test:fast-only": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=1024' TEST_TYPE=unit jest --testPathPattern='.*\\.(fast\\.test|auth|validation|utils|helpers)\\.' --maxWorkers=6 --testTimeout=3000 --detectOpenHandles",
    "test:medium": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=2048' TEST_TYPE=unit jest --testPathIgnorePatterns='.*\\.(fast\\.test|slow\\.test)\\.' --maxWorkers=2 --testTimeout=8000 --detectOpenHandles",
    "test:optimized": "pnpm test:fast-only && pnpm test:medium",
    "test:perf": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=1024' jest --config jest.config.performance.js --maxWorkers=auto --detectOpenHandles",
    "test:shard": "node scripts/test-sharding.js",
    "test:turbo": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.performance.js --maxWorkers=auto --bail --testTimeout=3000 --detectOpenHandles",
    "test:setup": "tsx scripts/setup-test-env.ts",
    "test:validate": "tsx scripts/validate-test-env.ts",
    "test:categorize": "node scripts/categorize-tests.js",
    "test:monitor-perf": "node scripts/test-performance-monitor.js benchmark 'pnpm test:turbo' 'current'",
    "test:pact": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPattern='.*\\.pact\\.test\\.' --detectOpenHandles",
    "test:pact:verify": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPattern='.*\\.pact-verify\\.test\\.' --detectOpenHandles",
    "test:pact:publish": "pact-broker publish ./pacts --consumer-app-version $npm_package_version --broker-base-url ${PACT_BROKER_URL:-http://localhost:9292} --broker-username ${PACT_BROKER_USERNAME:-} --broker-password ${PACT_BROKER_PASSWORD:-}",
    "test:mutation": "stryker run",
    "test:mutation:core": "stryker run --mutate 'src/services/**/*.ts' --mutate 'src/utils/**/*.ts'",
    "test:mutation:services": "stryker run --mutate 'src/services/**/*.ts'",
    "test:mutation:utils": "stryker run --mutate 'src/utils/**/*.ts'",
    "test:mutation:middleware": "stryker run --mutate 'src/middleware/**/*.ts'",
    "test:mutation:routes": "stryker run --mutate 'src/routes/**/*.ts'",
    "test:mutation:report": "stryker run --reporters html,clear-text,progress",
    "test:mutation:quick": "stryker run --maxConcurrentTestRunners 1 --timeoutMS 30000",
    "test:mutation:ci": "stryker run --maxConcurrentTestRunners 1 --reporters clear-text,progress --logLevel error",
    "lint": "eslint --config ../.eslintrc.json \"src/**/*.{ts,js}\"",
    "seed": "tsx tests/factories/seed/seedGenerator.ts",
    "seed:minimal": "tsx tests/factories/seed/seedGenerator.ts minimal",
    "seed:standard": "tsx tests/factories/seed/seedGenerator.ts standard",
    "seed:comprehensive": "tsx tests/factories/seed/seedGenerator.ts comprehensive --bilingual",
    "seed:performance": "tsx tests/factories/seed/seedGenerator.ts performance",
    "seed:clear": "CLEAR_DB=true tsx tests/factories/seed/seedGenerator.ts minimal"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.837.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.52.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/sdk-metrics": "^1.25.1",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/sdk-trace-base": "^1.25.1",
    "@opentelemetry/semantic-conventions": "^1.25.1",
    "@teaching-engine/database": "workspace:*",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "archiver": "^7.0.1",
    "axios": "^1.10.0",
    "canvas": "^3.1.2",
    "chart.js": "^4.5.0",
    "cheerio": "^1.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "debug": "^4.4.1",
    "express": "4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "html-to-docx": "^1.8.0",
    "ioredis": "^5.6.1",
    "isomorphic-dompurify": "^2.25.0",
    "jsdom": "^24.1.3",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.1",
    "nanoid": "^3.3.11",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-ical": "^0.20.1",
    "nodemailer": "^7.0.3",
    "openai": "^5.7.0",
    "pdfkit": "^0.17.1",
    "pino": "8.21.0",
    "pino-pretty": "^12.0.0",
    "rate-limiter-flexible": "^7.1.1",
    "unzipper": "^0.12.3",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "zod": "3.25.58"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@fast-check/jest": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@pact-foundation/pact": "^13.1.2",
    "@pact-foundation/pact-node": "^10.18.0",
    "@prisma/client": "^6.10.1",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/html-reporter": "^3.1.0",
    "@stryker-mutator/javascript-mutator": "^4.0.0",
    "@stryker-mutator/jest-runner": "^9.0.1",
    "@stryker-mutator/typescript-checker": "^9.0.1",
    "@swc/core": "^1.12.7",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^1.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/html-to-docx": "^1.8.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.1",
    "@types/node-cache": "^4.2.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.12",
    "@types/pdfkit": "^0.13.9",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.2",
    "bcryptjs": "^3.0.2",
    "docx-parser": "^0.2.1",
    "dotenv": "^16.5.0",
    "fast-check": "^4.1.1",
    "glob": "^10.4.5",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "node-fetch": "^3.3.2",
    "office-text-extractor": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
