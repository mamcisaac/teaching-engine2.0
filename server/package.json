{
  "name": "@teaching-engine/server",
  "version": "2.0.0",
  "description": "Teaching Engine 2.0 Backend Server with Real Implementation Testing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/templates dist/",
    "start": "node dist/index.js",
    "start:test": "NODE_ENV=test tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:real-implementation": "jest --testNamePattern=\"Real Implementation\"",
    "test:api-real": "jest --testPathPattern=\"api.*test\" --testNamePattern=\"Real Implementation\"",
    "test:performance": "jest --config jest.config.performance.js",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:validate-quality": "tsx scripts/validate-test-quality.ts",
    "test:lint-enforcement": "eslint --config .eslintrc.real-implementation.js **/*.test.ts",
    "test:performance-check": "tsx scripts/performance-check.ts",
    "test:db-connection": "tsx scripts/test-db-connection.ts",
    "test:db-integrity-check": "tsx scripts/db-integrity-check.ts",
    "test:performance-report": "tsx scripts/performance-report.ts",
    "test:performance-regression": "tsx scripts/performance-regression.ts",
    "test:performance-compare": "tsx scripts/performance-compare.ts",
    "test:performance-update-baseline": "tsx scripts/update-performance-baseline.ts",
    "test:coverage:comprehensive": "jest --coverage --testNamePattern=\"Real Implementation\"",
    "test:coverage:validate": "tsx scripts/validate-coverage.ts",
    "test:coverage:report": "tsx scripts/generate-coverage-report.ts",
    "test:coverage:real": "jest --coverage --testNamePattern=\"Real Implementation\"",
    "test:quality-gate": "tsx scripts/quality-gate-check.ts",
    "test:report:comprehensive": "tsx scripts/generate-comprehensive-report.ts",
    "test:security:real": "jest --testPathPattern=\"security.*test\" --testNamePattern=\"Real Implementation\"",
    "test:security:auth": "jest --testPathPattern=\"auth.*test\" --testNamePattern=\"Real Implementation\"",
    "test:assess-migration": "tsx scripts/assess-migration.ts",
    "test:migration-plan": "tsx scripts/generate-migration-plan.ts",
    "test:categorize-tests": "tsx scripts/categorize-tests.ts",
    "test:migration-validate": "tsx scripts/validate-migration.ts",
    "test:migration-report": "tsx scripts/generate-migration-report.ts",
    "test:migration-help": "tsx scripts/migration-help.ts",
    "test:debug-tools": "tsx scripts/debug-tools.ts",
    "dashboard:generate": "tsx scripts/generate-test-dashboard.ts",
    "dashboard:serve": "npx http-server reports -p 8080 -o",
    "dashboard:auto": "npm run dashboard:generate && npm run dashboard:serve",
    "lint": "eslint src/**/*.ts",
    "lint:real-tests": "eslint --config .eslintrc.real-implementation.js **/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage test-results reports",
    "seed": "tsx scripts/seed.ts",
    "db:migrate": "pnpm --filter @teaching-engine/database db:migrate",
    "db:generate": "pnpm --filter @teaching-engine/database db:generate",
    "db:push": "pnpm --filter @teaching-engine/database db:push",
    "db:seed": "pnpm --filter @teaching-engine/database db:seed",
    "db:reset": "pnpm --filter @teaching-engine/database db:reset",
    "db:studio": "pnpm --filter @teaching-engine/database db:studio"
  },
  "keywords": [
    "education",
    "teaching",
    "lesson-planning",
    "curriculum",
    "etfo",
    "real-implementation-testing"
  ],
  "author": "Teaching Engine Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.40.3",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.46.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.46.0",
    "@opentelemetry/resources": "^1.19.0",
    "@opentelemetry/sdk-node": "^0.46.0",
    "@opentelemetry/semantic-conventions": "^1.19.0",
    "@sentry/node": "^7.120.3",
    "@sentry/profiling-node": "^7.120.3",
    "@teaching-engine/database": "workspace:*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "ics": "^3.7.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "openai": "^4.28.4",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.14.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "redis": "^5.5.6",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "chart.js": "^4.4.1",
    "eslint": "^8.56.0",
    "faker": "^5.5.3",
    "fast-csv": "^4.3.6",
    "glob": "^10.3.10",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
