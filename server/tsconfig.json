{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "typeRoots": ["./src/types", "../node_modules/@types"],
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": false,
    "strictBindCallApply": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false
  },
  "include": ["src", "src/types/**/*"],
  "exclude": [
    "src/__tests__/**/*",
    "src/__mocks__/**/*",
    "**/__mocks__/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/services/analytics/curriculumAnalytics.ts",
    "src/services/analytics/domainAnalytics.ts",
    "src/services/analytics/themeAnalytics.ts",
    "src/middleware/rateLimit/**/*",
    "src/utils/errors.ts",
    "src/utils/performance.ts",
    "src/utils/routeFactory.ts",
    "src/utils/urlValidator.ts"
  ]
}
