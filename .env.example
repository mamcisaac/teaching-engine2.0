# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3000
NODE_ENV=development

# Authentication (REQUIRED - Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_IMMEDIATELY_USE_SECURE_RANDOM_VALUE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
VITE_API_URL=http://localhost:3000

# OpenAI (optional for AI features)
OPENAI_API_KEY=

# Logging
LOG_LEVEL=info

# Student Assessment System - Feature Flag
FEATURE_STUDENT_ASSESSMENT=true

# Storage Configuration for Student Artifacts
STORAGE_DRIVER=local       # one of: local, s3
UPLOAD_MAX_MB=25
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,video/mp4,video/quicktime,audio/mpeg,application/pdf

# S3 Storage (optional - only needed if STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BASE_URL=               # e.g., https://<bucket>.s3.amazonaws.com