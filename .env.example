# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication (REQUIRED - Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_IMMEDIATELY_USE_SECURE_RANDOM_VALUE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
VITE_API_URL=http://localhost:3000

# OpenAI (optional for AI features)
OPENAI_API_KEY=

# Logging
LOG_LEVEL=info

# ==========================================
# STUDENT ASSESSMENT SYSTEM CONFIGURATION
# ==========================================

# Feature Flag - Enable Student Assessment Features
FEATURE_STUDENT_ASSESSMENT=true

# Redis Configuration (Required for Queue Processing)
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=500
REDIS_CONNECT_TIMEOUT=10000

# Queue Configuration
QUEUE_CLEANUP_COMPLETED_JOBS_AGE=86400000  # 24 hours in ms
QUEUE_CLEANUP_FAILED_JOBS_AGE=604800000    # 7 days in ms
QUEUE_MAX_CONCURRENT_JOBS=5
QUEUE_DEFAULT_RETRY_ATTEMPTS=3

# Storage Configuration
STORAGE_DRIVER=local                       # Options: local, s3
UPLOAD_PATH=./uploads                      # Local storage path
UPLOAD_MAX_MB=25                          # Maximum file size in MB
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,video/mp4,video/quicktime,audio/mpeg,audio/wav,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Storage Quotas
STUDENT_STORAGE_QUOTA_GB=5                # Per-teacher storage limit
STORAGE_WARNING_THRESHOLD=0.8             # Warning at 80% usage
STORAGE_CRITICAL_THRESHOLD=0.9            # Critical at 90% usage

# S3 Storage Configuration (Only if STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BASE_URL=
S3_UPLOAD_TIMEOUT=300000                  # 5 minutes

# File Processing Configuration
IMAGE_THUMBNAIL_SIZE=200                  # Thumbnail size in pixels
VIDEO_THUMBNAIL_TIME=00:00:01             # Time to extract video thumbnail
DOCUMENT_PREVIEW_PAGES=3                  # Number of pages for document preview
AUDIO_WAVEFORM_SAMPLES=100               # Number of samples for audio waveform

# Performance Optimization
CACHE_TTL=1800                           # 30 minutes in seconds
CACHE_CHECK_PERIOD=600                   # 10 minutes in seconds
ANALYTICS_CACHE_TTL=3600                 # 1 hour in seconds
REPORT_GENERATION_TIMEOUT=120000         # 2 minutes in ms

# Export Configuration
EXPORT_BATCH_SIZE=100                    # Records per batch for export
CSV_MAX_RECORDS=10000                    # Maximum CSV export size
PDF_MAX_PAGES=500                        # Maximum PDF pages

# Email Configuration (Optional - for report delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@teaching-engine.com

# Security
ENCRYPTION_KEY=CHANGE_THIS_32_CHARACTER_ENCRYPTION_KEY
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET

# Development/Testing
ENABLE_TEST_ENDPOINTS=false              # Enable test endpoints
MOCK_FILE_PROCESSING=false              # Mock file processing for tests
VERBOSE_QUEUE_LOGGING=false             # Detailed queue logs